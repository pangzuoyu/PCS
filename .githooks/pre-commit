#!/bin/sh
# A-08 G-08 OpenAPI 契约自动化门禁（pre-commit hook）
#
# CI 不做（单人开发裁决，.wolf/STATUS.md §锁定用户裁决）；本地 git hook 替代。
# 两个独立触发段：A-08 OpenAPI 契约（下方）+ P9-Prep PP-5 alembic 漂移（上方）。
# 各段说明见 .githooks/README.md。
#
# 启用方式（仓库根执行一次）：
#     git config core.hooksPath .githooks
#
# 跳过方式（紧急 commit）：
#     git commit --no-verify
#
# 失败信息：commit 阻断；fix 见 pcs-backend/scripts/gate_08_openapi_contract.sh 注释

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT" || exit 1

# ---- P9-Prep PP-5: alembic 漂移闸门（独立触发条件）----
# 必须放在下面 OpenAPI 段的 `exit 0` 早退之前：
# 只改迁移文件时那条早退会先命中，新段永远走不到。
if git diff --cached --name-only | grep -qE '^pcs-backend/alembic/versions/'; then
    echo "[PP-5] alembic 漂移闸门触发（迁移文件改动）..."
    echo "----------------------------------------"
    if ! (cd "$REPO_ROOT/pcs-backend" && uv run python scripts/gate_alembic_check.py); then
        echo ""
        echo "[PP-5] ❌ 闸门 fail；commit 阻断"
        echo "紧急跳过：git commit --no-verify（需登记到 backlog）"
        exit 1
    fi
    echo ""
fi

# ---- R-19：前端 `meta/state-machine` seed ↔ 后端状态机（独立触发段）----
# ⚠️ 改了 `app/services/state_machine.py`（ALLOWED_TRANSITIONS / TRANSITION_ROLES）
# 或前端 seed ⇒ seed 可能陈旧 ⇒ MSW 的按钮与真后端不一致 ⇒ 按钮亮着点了 403 /
# 按钮被藏掉 ⇒ 用一条 pytest 挡住（0.1s、零 Postgres 依赖）。
# ⚠️ **用户 2026-10-27 裁决：只接 pre-commit**（不接 CI workflow）⇒ 本地提交
# 时就有反馈；CI 仍不跑这条（守门靠人工 + 批末回归）。
if git diff --cached --name-only | grep -qE '^(pcs-backend/app/services/state_machine\.py|pcs-frontend/src/mocks/seed/)'; then
    echo "[R-19] 状态机 seed 守卫触发..."
    echo "----------------------------------------"
    if ! (cd "$REPO_ROOT/pcs-backend" && uv run pytest tests/architecture/test_frontend_state_machine_seed.py -q); then
        echo ""
        echo "[R-19] ❌ 闸门 fail；commit 阻断"
        echo "修复：按 pytest 报错里给出的命令重新生成 pcs-frontend/src/mocks/seed/meta.state-machine.json"
        exit 1
    fi
    echo ""
fi

# 仅 OpenAPI/schemas 改动触发（性能优化）
if ! git diff --cached --name-only | grep -qE '^(pcs-backend/app/(api/v1|schemas)/|pcs-frontend/src/types/)'; then
    exit 0
fi

echo "[A-08] G-08 OpenAPI 契约门禁触发（OpenAPI/schemas 文件改动）..."
echo "----------------------------------------"
if ! bash pcs-backend/scripts/gate_08_openapi_contract.sh; then
    echo ""
    echo "----------------------------------------"
    echo "[A-08] ❌ G-08 fail；commit 阻断"
    echo "fix 步骤："
    echo "  1. bash pcs-backend/scripts/gate_08_openapi_contract.sh"
    echo "  2. 按错误提示修复（regen + drift + baseline）"
    echo "  3. 重新 git add + git commit"
    echo ""
    echo "紧急跳过：git commit --no-verify（需登记到 backlog）"
    exit 1
fi

exit 0