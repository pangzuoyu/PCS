TITLE PROJECT=SourWaterStripper, PROBLEM=TestFV, USER=PCS_TEST
   DIMENSION METRIC
   TOLER TEMP=0.1
 COMPONENT DATA
   LIBID 1,H2O/2,H2S/3,NH3/4,CO2/5,N2/6,O2
 THERMODYNAMIC DATA
   METHOD SET=1,DEFAULT,SYSTEM=SRK,ENTH=LIBR
   SRK   SET=1
 STREAM DATA
   PROPERTY STREAM=SOURW, TEMPERATURE=80, PRESSURE=800, PHASE=L, &
          RATE(W)=20000, COMPOSITION(M)=1,95/2,2/3,2/4,1, NORMALIZE
   PROPERTY STREAM=ACIDG, TEMPERATURE=40, PRESSURE=100, PHASE=V, &
          RATE(W)=400, COMPOSITION(M)=1,5/2,80/3,10/4,5, NORMALIZE
   PROPERTY STREAM=CLEANW, TEMPERATURE=110, PRESSURE=300, PHASE=L, &
          RATE(W)=19600, COMPOSITION(M)=1,99/2,0.5/3,0.5, NORMALIZE
   PROPERTY STREAM=STRIP, TEMPERATURE=130, PRESSURE=1200, PHASE=V, &
          RATE(W)=20000, COMPOSITION(M)=1,95/2,2/3,2/4,1, NORMALIZE
   PROPERTY STREAM=REBOIL, TEMPERATURE=125, PRESSURE=1200, PHASE=V, &
          RATE(W)=100, COMPOSITION(M)=1,100, NORMALIZE
   PROPERTY STREAM=VS1, TEMPERATURE=40, PRESSURE=100, PHASE=V, &
          RATE(W)=200, COMPOSITION(M)=1,5/2,80/3,10/4,5, NORMALIZE
   PROPERTY STREAM=VS2, TEMPERATURE=40, PRESSURE=100, PHASE=V, &
          RATE(W)=200, COMPOSITION(M)=1,5/2,80/3,10/4,5, NORMALIZE
   PROPERTY STREAM=FG1, TEMPERATURE=40, PRESSURE=100, PHASE=V, &
          RATE(W)=0, COMPOSITION(M)=1,0/2,0/3,0/4,0, NORMALIZE
   PROPERTY STREAM=FG2, TEMPERATURE=40, PRESSURE=100, PHASE=V, &
          RATE(W)=0, COMPOSITION(M)=1,0/2,0/3,0/4,0, NORMALIZE
 UNIT OPERATIONS
    VALVE UID=V01
       FEED SOURW
       PRODUCT M=ACIDFL
       OPERATION PRES=1500
    FLASH UID=ACIDFL_UID
       FEED ACIDFL
       PRODUCT V=ACIDG,L=STRIP
       ADIABATIC PRES=1500
    COLUMN UID=T201
      PARAMETER TRAY=20,IO=100
      FEED STRIP,10
      PRODUCT OVHD(WT)=VS1,200,BTMS(WT)=CLEANW,19600
      CONDENSER TYPE=PART,PRES=100
      DUTY 1,1,-3/2,20,5
      PSPEC PTOP=100,DPCOLUMN=50
      ESTIMATE MODEL=SIMPLE,RRATIO=2,CTEMP=40,TTEMP=110
      SPEC STRM=CLEANW,COMP=2,RATE,RATIO,REFF,VALUE=0.001,ATOL=0.0001
      VARY DUTY=1,2
    SPLITTER UID=SP1
       FEED VS1
       PRODUCT V=VS2,V=FG1
       OPERATION OPTION=FILL
       SPEC STREAM=VS2,RATE(W,KG/H),DIVIDE,VALUE=1
    SPLITTER UID=SP2
       FEED ACIDG
       PRODUCT V=FG2,L=FEED
       OPERATION OPTION=FILL
       SPEC STREAM=FEED,RATE(W,KG/H),DIVIDE,VALUE=0
    REBOILER UID=RB1
       FEED CLEANW
       PRODUCT V=REBOIL
       OPERATION TEMP=125,DP=0.5
 END