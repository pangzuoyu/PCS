TITLE PROJECT=Petroleum Fractionation, PROBLEM=Test34Comp, USER=PCS_TEST
   DIMENSION METRIC
   TOLER TEMP=0.1
 COMPONENT DATA
   LIBID 1,N2/2,CO2/3,H2S/4,C1/5,C2/6,C3/7,IC4/8,NC4/9,IC5/10,NC5/ &
          11,C6/12,C7/13,C8/14,C9/15,C10/16,C11/17,C12/18,C13/19,C14/ &
          20,C15/21,C16/22,C17/23,C18/24,C19/25,C20/26,C22/27,C24/ &
          28,C26/29,C28/30,C30/31,C32/32,C34/33,C36/34,C38
 THERMODYNAMIC DATA
   METHOD SET=1,DEFAULT,SYSTEM=SRK,ENTH=LIBR,ENTROPY(L)=SRK,ENTROPY(V)=SRK
   SRK   SET=1
 STREAM DATA
   PROPERTY STREAM=FEED, TEMPERATURE=380, PRESSURE=1500, PHASE=M, &
          RATE(W)=100000, COMPOSITION(M)=1,0.5/4,5.0/11,3.0/12,4.0/ &
          13,4.5/14,4.5/15,4.5/16,4.5/17,4.5/18,4.5/19,4.5/20,4.5/ &
          21,4.5/22,4.5/23,4.5/24,4.5/25,4.5/26,4.5/27,4.5/28,4.5/ &
          29,4.5/30,4.5/31,4.5/32,4.5/33,4.5/34,4.5, NORMALIZE
   PROPERTY STREAM=S1, TEMPERATURE=120, PRESSURE=1450, PHASE=M, &
          RATE(W)=20000, COMPOSITION(M)=1,0.8/4,12/11,8/12,10/13,11/ &
          14,11/15,11/16,11/17,11/18,11/19,5, NORMALIZE
   PROPERTY STREAM=S2, TEMPERATURE=180, PRESSURE=1430, PHASE=M, &
          RATE(W)=15000, COMPOSITION(M)=12,12/13,13/14,13/15,12/16,12/ &
          17,12/18,12/19,12, NORMALIZE
   PROPERTY STREAM=S3, TEMPERATURE=220, PRESSURE=1410, PHASE=M, &
          RATE(W)=12000, COMPOSITION(M)=19,10/20,12/21,12/22,12/23,12/ &
          24,12/25,12/26,16, NORMALIZE
   PROPERTY STREAM=S4, TEMPERATURE=260, PRESSURE=1390, PHASE=M, &
          RATE(W)=10000, COMPOSITION(M)=26,8/27,12/28,12/29,12/30,12/ &
          31,12/32,12/20, NORMALIZE
   PROPERTY STREAM=S5, TEMPERATURE=300, PRESSURE=1370, PHASE=M, &
          RATE(W)=10000, COMPOSITION(M)=31,8/32,12/33,12/34,24/ &
          29,12/30,12, NORMALIZE
   PROPERTY STREAM=S6, TEMPERATURE=340, PRESSURE=1350, PHASE=M, &
          RATE(W)=9000, COMPOSITION(M)=33,12/34,44/29,12/30,8/31,12/32,12, NORMALIZE
   PROPERTY STREAM=S7, TEMPERATURE=370, PRESSURE=1330, PHASE=M, &
          RATE(W)=8000, COMPOSITION(M)=33,18/34,32/29,14/30,8/31,8/32,8/33,12, NORMALIZE
   PROPERTY STREAM=OVHD, TEMPERATURE=80, PRESSURE=1300, PHASE=V, &
          RATE(W)=16000, COMPOSITION(M)=1,1.5/4,8/11,8/12,10/13,11/ &
          14,11/15,11/16,11/17,11/18,5, NORMALIZE
   PROPERTY STREAM=BTMS, TEMPERATURE=380, PRESSURE=1320, PHASE=L, &
          RATE(W)=84000, COMPOSITION(M)=19,8/20,11/21,11/22,11/23,11/ &
          24,11/25,11/26,11/27,11/28,11/29,11/30,11/31,11/32,11/33,11/34,11, NORMALIZE
   PROPERTY STREAM=REFLUX, TEMPERATURE=40, PRESSURE=1300, PHASE=L, &
          RATE(W)=4000, COMPOSITION(M)=4,90/11,5/12,5, NORMALIZE
   PROPERTY STREAM=REBOIL, TEMPERATURE=380, PRESSURE=1320, PHASE=L, &
          RATE(W)=4000, COMPOSITION(M)=33,50/34,50, NORMALIZE
   PROPERTY STREAM=S01, TEMPERATURE=100, PRESSURE=1400, PHASE=L, &
          RATE(W)=500, COMPOSITION(M)=11,50/12,50, NORMALIZE
   PROPERTY STREAM=S02, TEMPERATURE=150, PRESSURE=1380, PHASE=L, &
          RATE(W)=500, COMPOSITION(M)=15,50/16,50, NORMALIZE
   PROPERTY STREAM=S03, TEMPERATURE=200, PRESSURE=1360, PHASE=L, &
          RATE(W)=500, COMPOSITION(M)=19,50/20,50, NORMALIZE
   PROPERTY STREAM=S04, TEMPERATURE=250, PRESSURE=1340, PHASE=L, &
          RATE(W)=500, COMPOSITION(M)=23,50/24,50, NORMALIZE
   PROPERTY STREAM=S05, TEMPERATURE=280, PRESSURE=1320, PHASE=L, &
          RATE(W)=500, COMPOSITION(M)=26,50/27,50, NORMALIZE
   PROPERTY STREAM=S06, TEMPERATURE=310, PRESSURE=1300, PHASE=L, &
          RATE(W)=500, COMPOSITION(M)=29,50/30,50, NORMALIZE
   PROPERTY STREAM=S07, TEMPERATURE=340, PRESSURE=1280, PHASE=L, &
          RATE(W)=500, COMPOSITION(M)=31,50/32,50, NORMALIZE
   PROPERTY STREAM=SDRAW1, TEMPERATURE=180, PRESSURE=1380, PHASE=L, &
          RATE(W)=3000, COMPOSITION(M)=12,40/13,40/14,20, NORMALIZE
   PROPERTY STREAM=SDRAW2, TEMPERATURE=260, PRESSURE=1340, PHASE=L, &
          RATE(W)=3000, COMPOSITION(M)=24,40/25,40/26,20, NORMALIZE
 UNIT OPERATIONS
    COLUMN UID=T01
      PARAMETER TRAY=30,IO=100
      FEED FEED,15
      PRODUCT OVHD(WT)=OVHD,40000,BTMS(WT)=BTMS,60000, &
              LDRAW=SDRAW1,15,3000/LDRAW=SDRAW2,20,3000
      CONDENSER TYPE=PART,PRES=1300
      DUTY 1,1,-15/2,30,18
      PSPEC PTOP=1300,DPCOLUMN=50
      ESTIMATE MODEL=SIMPLE,RRATIO=2,CTEMP=80,TTEMP=380
      SPEC STRM=BTMS,COMP=34,RATE,RATIO,REFF,VALUE=0.10,ATOL=0.001
      VARY DUTY=1,2
    HX UID=E01
       HOT FEED=OVHD,M=REFLUX,DP=0.5
       OPER HTEMP=40
    PUMP UID=P01
       FEED REFLUX
       PRODUCT M=FEED
       OPERATION EFF=70,DP=2.0
    SIDESTRIPPER UID=SS1
       FEED SDRAW1
       PRODUCT OVHD(WT)=S01,500,BTMS(WT)=S02,500
       CONDENSER TYPE=BUBB,PRES=1400
    SIDESTRIPPER UID=SS2
       FEED SDRAW2
       PRODUCT OVHD(WT)=S05,500,BTMS(WT)=S06,500
       CONDENSER TYPE=BUBB,PRES=1340
    MIXER UID=M01
       FEED BTMS,REBOIL
       PRODUCT M=FEED
 END