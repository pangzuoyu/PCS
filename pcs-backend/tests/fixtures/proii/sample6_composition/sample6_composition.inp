TITLE PROJECT=PCS_COMPOSITION, PROBLEM=TestComposition, USER=PCS_TEST
   DIMENSION METRIC
   TOLER TEMP=0.1
 COMPONENT DATA
   LIBID 1,H2O/2,PO/3,METHANOL/4,CO2/5,C99
 THERMODYNAMIC DATA
   METHOD SET=1,DEFAULT,SYSTEM=SRK,ENTH=LIBR
   SRK   SET=1
 STREAM DATA
   PROPERTY STREAM=S1, TEMPERATURE=60, PRESSURE=500, PHASE=L, &
          RATE(W)=10000, COMPOSITION(M)=1,10/2,60/3,25/4,5, NORMALIZE
   PROPERTY STREAM=S2, TEMPERATURE=30, PRESSURE=300, PHASE=L, &
          RATE(W)=5000, COMPOSITION(W)=1,80/2,15/3,5, NORMALIZE
   PROPERTY STREAM=S3, TEMPERATURE=90, PRESSURE=800, PHASE=V, &
          RATE(W)=3000, COMPOSITION(M)=1,50/5,50, NORMALIZE
 UNIT OPERATIONS
    COLUMN UID=T1
      PARAMETER TRAY=10,IO=100
      FEED S1,10
      PRODUCT OVHD(WT)=S2,5000,BTMS(WT)=S3,3000
      CONDENSER TYPE=PART,PRES=300
      DUTY 1,1,-5/2,20,8
      PSPEC PTOP=300,DPCOLUMN=100
      ESTIMATE MODEL=SIMPLE,RRATIO=5,CTEMP=30,TTEMP=90
      SPEC STRM=S2,COMP=3,RATE,RATIO,REFF,VALUE=0.9999,ATOL=0.0001
      VARY DUTY=1,2
 END
