TITLE PROJECT=NotConverged, PROBLEM=TestNC, USER=PCS_TEST
   DIMENSION METRIC
   TOLER TEMP=0.1
 COMPONENT DATA
   LIBID 1,N2/2,CO2/3,C1/4,C2/5,C3/6,IC4/7,NC4/8,NC5
 THERMODYNAMIC DATA
   METHOD SET=1,DEFAULT,SYSTEM=SRK,ENTH=LIBR
   SRK   SET=1
 STREAM DATA
   PROPERTY STREAM=S1, TEMPERATURE=40, PRESSURE=2000, PHASE=M, &
          RATE(W)=50000, COMPOSITION(M)=1,2/2,3/3,30/4,30/5,20/6,5/7,5/8,5, NORMALIZE
   PROPERTY STREAM=S2, TEMPERATURE=-30, PRESSURE=100, PHASE=V, &
          RATE(W)=20000, COMPOSITION(M)=1,5/3,80/4,15, NORMALIZE
   PROPERTY STREAM=S3, TEMPERATURE=200, PRESSURE=2050, PHASE=L, &
          RATE(W)=30000, COMPOSITION(M)=5,30/6,30/7,20/8,20, NORMALIZE
 UNIT OPERATIONS
    COLUMN UID=T1
      PARAMETER TRAY=20,IO=100
      FEED S1,10
      PRODUCT OVHD(WT)=S2,20000,BTMS(WT)=S3,30000
      CONDENSER TYPE=PART,PRES=100
      DUTY 1,1,-5/2,20,8
      PSPEC PTOP=100,DPCOLUMN=100
      ESTIMATE MODEL=SIMPLE,RRATIO=5,CTEMP=-30,TTEMP=200
      SPEC STRM=S2,COMP=3,RATE,RATIO,REFF,VALUE=0.9999,ATOL=0.0001
      VARY DUTY=1,2
 END