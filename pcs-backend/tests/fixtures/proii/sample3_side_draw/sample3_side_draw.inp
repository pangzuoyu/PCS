TITLE PROJECT=SideDrawCrude, PROBLEM=TestSD, USER=PCS_TEST
   DIMENSION METRIC
   TOLER TEMP=0.1
 COMPONENT DATA
   LIBID 1,H2O/2,N2/3,CO2/4,H2S/5,C1/6,C2/7,C3/8,IC4/9,NC4/10,IC5/ &
          11,NC5/12,C6/13,C7/14,C8/15,C9/16,C10/17,C11/18,C12/19,C13/ &
          20,C14/21,C15/22,C16/23,C17/24,C18/25,C19/26,C20/27,C22/28,C24/ &
          29,C26/30,C28/31,C30/32,C32/33,C34/34,C36/35,C38/36,C40/37,C42/38,C44
 THERMODYNAMIC DATA
   METHOD SET=1,DEFAULT,SYSTEM=SRK,ENTH=LIBR
   SRK   SET=1
 STREAM DATA
   PROPERTY STREAM=CRUDE, TEMPERATURE=380, PRESSURE=1800, PHASE=M, &
          RATE(W)=150000, COMPOSITION(M)=1,0.1/2,0.3/3,0.5/4,1.0/5,2.0/ &
          11,3/12,3.5/13,3.5/14,3.5/15,3.5/16,3.5/17,3.5/18,3.5/19,3.5/ &
          20,3.5/21,3.5/22,3.5/23,3.5/24,3.5/25,3.5/26,3.5/27,3.5/28,3.5/ &
          29,3.5/30,3.5/31,3.5/32,3.5/33,3.5/34,3.5/35,3.5/36,3.5/37,3.5/38,3.5, NORMALIZE
   PROPERTY STREAM=OVHD, TEMPERATURE=120, PRESSURE=1700, PHASE=M, &
          RATE(W)=8000, COMPOSITION(M)=1,2/2,5/3,8/4,15/5,30/6,40, NORMALIZE
   PROPERTY STREAM=NAVGAS, TEMPERATURE=80, PRESSURE=1600, PHASE=V, &
          RATE(W)=6000, COMPOSITION(M)=11,40/12,40/13,20, NORMALIZE
   PROPERTY STREAM=KERO, TEMPERATURE=180, PRESSURE=1580, PHASE=L, &
          RATE(W)=15000, COMPOSITION(M)=15,30/16,40/17,30, NORMALIZE
   PROPERTY STREAM=DIESEL, TEMPERATURE=260, PRESSURE=1560, PHASE=L, &
          RATE(W)=20000, COMPOSITION(M)=21,25/22,30/23,25/24,20, NORMALIZE
   PROPERTY STREAM=GASOIL, TEMPERATURE=320, PRESSURE=1540, PHASE=L, &
          RATE(W)=25000, COMPOSITION(M)=27,25/28,25/29,25/30,25, NORMALIZE
   PROPERTY STREAM=RESID, TEMPERATURE=380, PRESSURE=1520, PHASE=L, &
          RATE(W)=76000, COMPOSITION(M)=35,30/36,30/37,20/38,20, NORMALIZE
 UNIT OPERATIONS
    COLUMN UID=T101
      PARAMETER TRAY=40,IO=200
      FEED CRUDE,20
      PRODUCT OVHD(WT)=OVHD,8000,BTMS(WT)=RESID,76000, &
              LDRAW=NAVGAS,5,6000/LDRAW=KERO,12,15000/ &
              LDRAW=DIESEL,18,20000/LDRAW=GASOIL,28,25000
      CONDENSER TYPE=PART,PRES=1700
      DUTY 1,1,-25/2,40,30
      PSPEC PTOP=1700,DPCOLUMN=80
      ESTIMATE MODEL=SIMPLE,RRATIO=3,CTEMP=120,TTEMP=380
      SPEC STRM=RESID,COMP=38,RATE,RATIO,REFF,VALUE=0.05,ATOL=0.001
      VARY DUTY=1,2
    SIDESTRIPPER UID=SS1
       FEED NAVGAS
       PRODUCT OVHD(WT)=S01,5500,BTMS(WT)=S02,500
       CONDENSER TYPE=BUBB,PRES=1600
    SIDESTRIPPER UID=SS2
       FEED KERO
       PRODUCT OVHD(WT)=S03,3000,BTMS(WT)=S04,12000
       CONDENSER TYPE=BUBB,PRES=1580
    SIDESTRIPPER UID=SS3
       FEED DIESEL
       PRODUCT OVHD(WT)=S05,4000,BTMS(WT)=S06,16000
       CONDENSER TYPE=BUBB,PRES=1560
    SIDESTRIPPER UID=SS4
       FEED GASOIL
       PRODUCT OVHD(WT)=S07,5000,BTMS(WT)=S08,20000
       CONDENSER TYPE=BUBB,PRES=1540
 END