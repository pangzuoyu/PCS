TITLE PROJECT=ReactorExtraction, PROBLEM=TestRX, USER=PCS_TEST
   DIMENSION METRIC
   TOLER TEMP=0.1
 COMPONENT DATA
   LIBID 1,H2O/2,PO/3,PC/4,ME/5,DMC/6,12PG/7,CO2/8,N2/9,O2/10,AA
 THERMODYNAMIC DATA
   METHOD SET=1,DEFAULT,SYSTEM=NRTL3,ENTH=LIBR
   NRTL3 SET=1
 RXDATA
   RXSET ID=DMCSET
   REACTION ID=RX1
     STOICHIOMETRY 3,-1/4,-2/5,1/6,1
     HORX HEAT=-2.1978,REFCOMP=3,REFTEMP=25
     KINETICS PEXP=9785,ACTIVATION=9.615
   REACTION ID=RX2
     STOICHIOMETRY 3,1/4,2/5,-1/6,-1
     HORX HEAT=2.1978,REFCOMP=3,REFTEMP=25
     KINETICS PEXP=1.972E6,ACTIVATION=11.771
   REACTION ID=RX3
     STOICHIOMETRY 3,-1/2,-1/1,1
     HORX HEAT=-0.5,REFCOMP=3,REFTEMP=25
     KINETICS PEXP=1000,ACTIVATION=8.0
   REACTION ID=RX4
     STOICHIOMETRY 6,1/2,-1/1,-1
     HORX HEAT=-0.3,REFCOMP=6,REFTEMP=25
     KINETICS PEXP=500,ACTIVATION=7.0
 STREAM DATA
   PROPERTY STREAM=FEED, TEMPERATURE=40, PRESSURE=40, PHASE=M, &
          RATE(W)=860, COMPOSITION(M)=1,0.01/2,99.9, NORMALIZE
   PROPERTY STREAM=CAT, TEMPERATURE=40, PRESSURE=40, PHASE=M, &
          RATE(W)=30, COMPOSITION(M)=4,20/3,80, NORMALIZE
   PROPERTY STREAM=S2, TEMPERATURE=65, PRESSURE=1.1, PHASE=M, &
          RATE(M)=44, COMPOSITION(M)=1,20/10,80, NORMALIZE
   PROPERTY STREAM=PROD, TEMPERATURE=80, PRESSURE=35, PHASE=M, &
          RATE(W)=890, COMPOSITION(M)=4,40/5,40/6,15/1,5, NORMALIZE
   PROPERTY STREAM=EXTRACT, TEMPERATURE=40, PRESSURE=20, PHASE=L, &
          RATE(W)=445, COMPOSITION(M)=5,80/6,20, NORMALIZE
   PROPERTY STREAM=RAFFINATE, TEMPERATURE=40, PRESSURE=20, PHASE=L, &
          RATE(W)=445, COMPOSITION(M)=1,90/4,10, NORMALIZE
   PROPERTY STREAM=VAP, TEMPERATURE=60, PRESSURE=3.0, PHASE=V, &
          RATE(W)=200, COMPOSITION(M)=5,20/6,40/7,40, NORMALIZE
   PROPERTY STREAM=LIQ, TEMPERATURE=60, PRESSURE=3.0, PHASE=L, &
          RATE(W)=690, COMPOSITION(M)=5,15/6,30/4,30/1,25, NORMALIZE
   PROPERTY STREAM=SPLIT1, TEMPERATURE=40, PRESSURE=20, PHASE=L, &
          RATE(W)=222, COMPOSITION(M)=5,80/6,20, NORMALIZE
   PROPERTY STREAM=SPLIT2, TEMPERATURE=40, PRESSURE=20, PHASE=L, &
          RATE(W)=223, COMPOSITION(M)=5,80/6,20, NORMALIZE
 UNIT OPERATIONS
    REACTOR UID=R101
       FEED FEED,CAT
       PRODUCT M=PROD
       OPERATION ADIABATIC,DP=0.5
       RXCALCULATION MODEL=STOIC,CONVERSION
       RXSTOIC RXSET=DMCSET
       REACTION CO2+PO--PC
       STOICHIOMETRY 7,-1/2,-1/3,1
       BASE COMPONENT=2
       CONVERSION 0.95
    EXTRACTOR UID=EX1
       FEED PROD,FEED2
       PRODUCT M=RAFFINATE,L=EXTRACT
       OPERATION TEMP=40,DP=0.3,NSTAGE=3
    MIXER UID=M1
       FEED PROD
       PRODUCT M=FEED2
    COMPRESSOR UID=C1
       FEED EXTRACT
       PRODUCT V=VAP,L=LIQ
       OPERATION CALC=ASME,PRES=3.61
    SPLITTER UID=SP1
       FEED EXTRACT
       PRODUCT M=SPLIT1,M=SPLIT2
       OPERATION OPTION=FILL
       SPEC STREAM=SPLIT1,RATE(W,KG/H),DIVIDE,VALUE=1
    STCA UID=S2_U
       FEED LIQ
       OVHD STRM=VAP,TEMP=60,DP=0.2
       BTMS STRM=CO2,TEMP=60,DP=0.2
       FOVH 5,5,1.0/6,6,0.5/4,4,0.0/1,1,0.0
    CALCULATOR UID=CA1
       SEQUENCE STREAM=FEED,CAT,PROD
       PROCEDURE
       V(1)=SMR(FEED)
       V(2)=SMR(CAT)
       R(1)=(V(1)+V(2))*1.05
       CALL SRXSTR(SMR,R(1),PROD)
       RETURN
    HX UID=E1
       HOT FEED=PROD,M=FEED2,DP=0.5
       OPER HTEMP=40
 END