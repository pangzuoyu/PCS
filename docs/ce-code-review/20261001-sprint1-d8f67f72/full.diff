     POWER_FAILURE 在 P5-OPEN-005 合并版改为 UPSET（覆盖更广）。当前采纳 P5-OPEN-005 6 态。
     """
 
     FIRE = "FIRE"
     CLOSED_VALVE = "CLOSED_VALVE"
