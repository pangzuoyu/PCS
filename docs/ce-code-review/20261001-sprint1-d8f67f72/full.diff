+    # 起两个并发任务竞争同一 (project_id, tag_number)
+    t1, t2 = asyncio.create_task(_sync_one()), asyncio.create_task(_sync_one())
+    r1, r2 = await asyncio.gather(t1, t2)
+    assert r1 == "ok"
+    assert r2 == "ok"  # 都成功（一个创建，一个更新）
