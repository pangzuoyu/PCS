diff --git a/pcs-backend/tests/architecture/test_no_direct_ai_sdk.py b/pcs-backend/tests/architecture/test_no_direct_ai_sdk.py
new file mode 100644
index 0000000..eb0a6b1
--- /dev/null
+++ b/pcs-backend/tests/architecture/test_no_direct_ai_sdk.py
@@ -0,0 +1,153 @@
+"""AI SDK 的**架构守卫**（P10-A · Task T14）。
+
+## 为什么需要
+
+AI 端点现在一律 501 ⇒ AI 调用**只能**从
+`app/core/outbound_ai_client.py` 出去（那里有：调用时二次校验内网 CIDR ·
+脱敏 · 审计）。
+⇒ 有人**绕过**它直连模型服务 ⇒ 少了三道防护（内网校验 / 脱敏 / 审计）。
+
+⇒ 守卫把「唯一的出口」钉死。
+
+## ⚠️ 静态扫描的局限（写在这里，别把它当万能护栏）
+
+本守卫扫的是 **URL 字面量 / 属性名** ⇒ `httpx.post(url_var, ...)`（url 是
+局部变量）**扫不到** ⇒ 将来若有人用变量调 AI 端点，守卫**抓不到**。
+⇒ 约定：**AI 端点的 URL 必须直接写 `settings.ai_endpoint` 或字面量**，
+否则绕过守卫。
+"""
+from __future__ import annotations
+
+import ast
+from pathlib import Path
+
+APP_ROOT = Path(__file__).resolve().parents[2] / "app"
+
+#: 允许出现 AI SDK 的文件（**唯一出口**）。
+ALLOWED_FILE = "core/outbound_ai_client.py"
+
+#: 被禁止的 AI SDK 顶层包名。
+FORBIDDEN_SDK_ROOTS = frozenset(
+    {
+        "openai",
+        "ollama",
+        "vllm",
+        "langchain",
+        "langchain_core",
+        "langchain_community",
+        "langgraph",
+        "llama_index",
+        "chromadb",
+        "sentence_transformers",
+        "transformers",
+        "torch",
+        "anthropic",
+        "litellm",
+    }
+)
+
+#: 「这个调用在打 AI 端点」的特征串（URL 字面量 / 属性名）。
+AI_ENDPOINT_MARKERS = ("ai_endpoint", "/api/v1/ai", "ai.intent", "ai/knowledge")
+
+
+def _python_files() -> list[Path]:
+    return sorted(p for p in APP_ROOT.rglob("*.py"))
+
+
+def _rel(path: Path) -> str:
+    return str(path.relative_to(APP_ROOT))
+
+
+def _imported_roots(tree: ast.AST) -> set[str]:
+    roots: set[str] = set()
+    for node in ast.walk(tree):
+        if isinstance(node, ast.Import):
+            for alias in node.names:
+                roots.add(alias.name.split(".", 1)[0])
+        elif isinstance(node, ast.ImportFrom):
+            if node.level == 0 and node.module:
+                roots.add(node.module.split(".", 1)[0])
+    return roots
+
+
+def _httpx_calls(tree: ast.AST) -> list[ast.Call]:
+    """所有**看起来像 httpx 调用**的节点（含 `httpx.post` / `httpx.Client(...)`）。"""
+    calls: list[ast.Call] = []
+    for node in ast.walk(tree):
+        if not isinstance(node, ast.Call):
+            continue
+        func = node.func
+        if isinstance(func, ast.Attribute) and isinstance(func.value, ast.Name):
+            if func.value.id == "httpx":
+                calls.append(node)
+        elif isinstance(func, ast.Name) and func.id in {"httpx"}:
+            calls.append(node)
+    return calls
+
+
+def _mentions_ai_endpoint(node: ast.AST) -> bool:
+    """这个表达式里有没有「AI 端点」的特征。"""
+    for sub in ast.walk(node):
+        if isinstance(sub, ast.Constant) and isinstance(sub.value, str):
+            if any(marker in sub.value for marker in AI_ENDPOINT_MARKERS):
+                return True
+        if isinstance(sub, ast.Attribute) and sub.attr in {"ai_endpoint"}:
+            return True
+    return False
+
+
+def test_no_module_outside_outbound_client_imports_ai_sdks() -> None:
+    """openai / ollama / vllm / langchain **只**允许出现在
+    `app/core/outbound_ai_client.py`。
+
+    ⚠️ 本批**还没装**这些包 ⇒ 全仓零命中 ⇒ 本条现在**恒绿**。
+    ⇒ 它是**防将来**的棘轮：真装上之后，有人绕过唯一出口直连 ⇒ 这里红。
+    """
+    offenders: list[str] = []
+    for path in _python_files():
+        rel = _rel(path)
+        if rel == ALLOWED_FILE:
+            continue
+        tree = ast.parse(path.read_text(encoding="utf-8"), filename=str(path))
+        hit = _imported_roots(tree) & FORBIDDEN_SDK_ROOTS
+        if hit:
+            offenders.append(f"{rel}: {sorted(hit)}")
+
+    assert not offenders, (
+        "AI SDK 只允许出现在 app/core/outbound_ai_client.py（唯一出口）："
+        f"{offenders}"
+    )
+
+
+def test_only_outbound_client_calls_httpx_with_an_ai_endpoint() -> None:
+    """⚠️ **httpx 允许被多处用**（不是禁 httpx）⇒ 守卫的是「httpx 调 **AI 端点**」
+    ⇒ 只允许 `app/core/outbound_ai_client.py`。
+
+    ⚠️ **静态扫描的局限**：本守卫扫 URL 字面量 / 属性名 ⇒
+    `httpx.post(url_var, ...)` 扫不到 ⇒ 约定 AI 端点的 URL 必须直接写
+    `settings.ai_endpoint` 或字面量。
+    """
+    offenders: list[str] = []
+    for path in _python_files():
+        rel = _rel(path)
+        if rel == ALLOWED_FILE:
+            continue
+        tree = ast.parse(path.read_text(encoding="utf-8"), filename=str(path))
+        for call in _httpx_calls(tree):
+            # ⚠️ **两种传法都要看**（评审 L-4）：`httpx.post(url, ...)` 的位置
+            # 参数，**以及** `httpx.post(url=..., ...)` 的关键字参数。
+            candidates = list(call.args[:1])
+            candidates += [kw.value for kw in call.keywords if kw.arg == "url"]
+            for candidate in candidates:
+                if _mentions_ai_endpoint(candidate):
+                    offenders.append(f"{rel}:{call.lineno}")
+
+    assert not offenders, (
+        "用 httpx 打 AI 端点只允许在 app/core/outbound_ai_client.py："
+        f"{offenders}"
+    )
+
+
+def test_the_allowed_file_is_the_only_ai_exit() -> None:
+    """**唯一出口**本身必须存在（守卫不能指向一个不存在的文件）。"""
+    assert (APP_ROOT / ALLOWED_FILE).exists(), f"唯一出口 {ALLOWED_FILE} 不存在"
diff --git a/pcs-backend/tests/core/test_ai_cidr.py b/pcs-backend/tests/core/test_ai_cidr.py
new file mode 100644
index 0000000..2d98b15
--- /dev/null
+++ b/pcs-backend/tests/core/test_ai_cidr.py
@@ -0,0 +1,150 @@
+"""`app/core/ai_cidr.py` 的测试（P10-A · Task T5）。
+
+## 为什么要有这一层
+
+SPEC §2.5「**私有化强制**：所有 LLM 模型必须部署于公司内网，禁止调用外部云
+AI 服务」⇒ endpoint 的 IP **必须**落在内网 CIDR 里。
+⇒ 校验点有两个：**启动时**（配置错了就别起）· **调用时**（防 DNS 漂移）。
+
+## 三条容易写错的
+
+1. **地址族不匹配不得抛** —— `IPv6Address in IPv4Network` 是 `TypeError`
+   ⇒ 一个 IPv6 endpoint 打 IPv4 CIDR 会直接崩（而不是「不匹配」）。
+2. **非法 CIDR ⇒ `RuntimeError`**（不是裸 `ValueError`）—— 启动时抛裸
+   `ValueError` 运维看不懂 ⇒ 消息里要带**原文**。
+3. **DNS 必须 mock** —— 真解析依赖网络 ⇒ 测试环境可能无网/不稳定 ⇒ flaky。
+"""
+from __future__ import annotations
+
+import socket
+
+import pytest
+
+from app.core.ai_cidr import (
+    ip_in_cidrs,
+    parse_cidrs,
+    resolve_ai_endpoint_ips,
+    validate_ai_endpoint,
+    validate_ai_startup_config,
+)
+
+
+def test_parse_cidrs_handles_empty_and_spaces() -> None:
+    """'' ⇒ []；' 10.0.0.0/8 , 192.168.0.0/16 ' ⇒ 两条（去空格）。"""
+    assert parse_cidrs("") == []
+    assert parse_cidrs("   ") == []
+    assert parse_cidrs(" 10.0.0.0/8 , 192.168.0.0/16 ") == [
+        "10.0.0.0/8",
+        "192.168.0.0/16",
+    ]
+
+
+def test_parse_cidrs_rejects_invalid_cidr_with_clear_message() -> None:
+    """'not-a-cidr' ⇒ RuntimeError，消息里含那个串。
+
+    ⚠️ 必须是 `RuntimeError` 而不是裸 `ValueError` —— 启动时抛裸
+    `ValueError` 运维看不懂「哪个值坏了」。
+    """
+    with pytest.raises(RuntimeError) as excinfo:
+        parse_cidrs("not-a-cidr")
+
+    assert "not-a-cidr" in str(excinfo.value)
+
+
+def test_ip_in_cidrs_handles_ipv6_against_ipv4_list() -> None:
+    """⚠️ **地址族不匹配不得抛** —— `IPv6Address in IPv4Network` 会 TypeError
+    ⇒ 必须捕获并返回 False（否则一个 IPv6 endpoint 打 IPv4 CIDR 直接崩）。"""
+    assert ip_in_cidrs("fd00::1", ["10.0.0.0/8"]) is False
+
+
+def test_ip_in_cidrs_supports_ipv6() -> None:
+    """'fd00::1' in ['fd00::/8'] ⇒ True。"""
+    assert ip_in_cidrs("fd00::1", ["fd00::/8"]) is True
+
+
+def test_ip_in_cidrs_returns_false_for_garbage_ip() -> None:
+    """非法 IP ⇒ False（不是抛）—— 调用方拿它做「要不要拒绝」的判断。"""
+    assert ip_in_cidrs("not-an-ip", ["10.0.0.0/8"]) is False
+
+
+def test_validate_ai_endpoint_rejects_public_ip() -> None:
+    """8.8.8.8 + ['10.0.0.0/8'] ⇒ RuntimeError。"""
+    with pytest.raises(RuntimeError):
+        validate_ai_endpoint("8.8.8.8", ["10.0.0.0/8"])
+
+
+def test_validate_ai_endpoint_accepts_private_ip() -> None:
+    """10.1.2.3 + ['10.0.0.0/8'] ⇒ 不抛。"""
+    validate_ai_endpoint("10.1.2.3", ["10.0.0.0/8"])
+
+
+def test_validate_ai_endpoint_rejects_dns_resolving_outside(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """域名解析到公网 ⇒ RuntimeError。
+
+    ⚠️ **必须 mock DNS**（`monkeypatch.setattr(socket, "getaddrinfo", fake)`）——
+    真解析依赖网络 ⇒ 测试环境可能无网/不稳定 ⇒ **flaky 测试**。
+    """
+
+    def fake_getaddrinfo(host, port, *args, **kwargs):  # noqa: ANN001, ANN002, ANN003, ANN201
+        return [(socket.AF_INET, socket.SOCK_STREAM, 6, "", ("8.8.8.8", 443))]
+
+    monkeypatch.setattr(socket, "getaddrinfo", fake_getaddrinfo)
+
+    with pytest.raises(RuntimeError):
+        validate_ai_endpoint("ai.example.internal", ["10.0.0.0/8"])
+
+
+def test_resolve_ai_endpoint_ips_returns_literal_for_ip_endpoint() -> None:
+    """IP 字面量 ⇒ 直接返回它（**不解析 DNS**）。"""
+    assert resolve_ai_endpoint_ips("10.1.2.3") == ["10.1.2.3"]
+
+
+def test_resolve_ai_endpoint_ips_raises_on_unresolvable_host(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """域名解析失败 ⇒ RuntimeError（不是空列表 ⇒ 空列表会被当成「不在内网」）。
+
+    ⚠️ 空列表的语义歧义：解析失败 vs 解析到公网 ⇒ 两者处置不同 ⇒ 抛错。
+    ⚠️ **mock 掉 DNS** —— 真解析依赖网络（可能无网 / 很慢 ⇒ flaky）。
+    """
+
+    def fake_getaddrinfo(host, port, *args, **kwargs):  # noqa: ANN001, ANN002, ANN003, ANN201
+        raise socket.gaierror("Name or service not known")
+
+    monkeypatch.setattr(socket, "getaddrinfo", fake_getaddrinfo)
+
+    with pytest.raises(RuntimeError):
+        resolve_ai_endpoint_ips("no-such-host.invalid")
+
+
+# ---------------------------------------------------------------------------
+# 启动时校验（SPEC §3.2.1(5)）—— 判定逻辑是**纯函数** ⇒ 好测
+# ---------------------------------------------------------------------------
+
+
+def test_startup_validation_passes_when_ai_disabled() -> None:
+    """AI 关着 ⇒ **直接放行**（P10 阶段 AI 默认关 ⇒ 不能挡住服务启动）。"""
+    validate_ai_startup_config(ai_enabled=False, endpoint=None, cidrs=[])
+
+
+def test_startup_validation_rejects_enabled_without_endpoint() -> None:
+    """AI 开着但 endpoint 为空 ⇒ RuntimeError。"""
+    with pytest.raises(RuntimeError):
+        validate_ai_startup_config(ai_enabled=True, endpoint=None, cidrs=["10.0.0.0/8"])
+
+
+def test_startup_validation_rejects_endpoint_outside_cidrs() -> None:
+    """AI 开着 + endpoint 在公网 ⇒ RuntimeError（**启动即失败**，不是等第一次调用）。"""
+    with pytest.raises(RuntimeError):
+        validate_ai_startup_config(
+            ai_enabled=True, endpoint="8.8.8.8", cidrs=["10.0.0.0/8"]
+        )
+
+
+def test_startup_validation_accepts_endpoint_inside_cidrs() -> None:
+    """AI 开着 + endpoint 在内网 ⇒ 放行。"""
+    validate_ai_startup_config(
+        ai_enabled=True, endpoint="10.1.2.3", cidrs=["10.0.0.0/8"]
+    )
diff --git a/pcs-backend/tests/core/test_ai_sanitizer.py b/pcs-backend/tests/core/test_ai_sanitizer.py
new file mode 100644
index 0000000..acc4b98
--- /dev/null
+++ b/pcs-backend/tests/core/test_ai_sanitizer.py
@@ -0,0 +1,140 @@
+"""`app/core/ai_sanitizer.py` 的测试（P10-A · Task T6）。
+
+## 为什么脱敏是强制的
+
+SPEC §2.5「**数据脱敏强制**：发送给 LLM 的文本必须经过脱敏处理」。
+
+## 脱敏哪几类
+
+- **SPEC §3.2.1(3) 的三类**（权威）：设备位号 `[EQUIPMENT_TAG]` ·
+  项目编号 `[PROJECT_NO]` · 管线号 `[LINE_NO]`
+- **邮箱 / 手机号**（计划的追加项）：`[EMAIL]` · `[PHONE]`
+
+## 人名遮蔽**默认关**
+
+开了会把几乎每个中文词都遮掉 ⇒ 脱敏后的文本基本不可读 ⇒ 默认关，
+且由 env `AI_MASK_PERSON_NAME` 显式 opt-in（接线在 `app/main.py`）。
+
+⚠️ 实现是**标签锚定**的启发式（只在「姓名：」「负责人：」这类标签之后遮蔽）
+⇒ 不会把普通词当人名。
+"""
+from __future__ import annotations
+
+import pytest
+
+from app.core.ai_sanitizer import (
+    enable_person_name_mask,
+    hash_sanitized,
+    sanitize_for_ai,
+)
+
+
+def test_sanitize_masks_email_and_phone_in_nested_payload() -> None:
+    """嵌套 dict/list 里的邮箱与手机号都被替换（递归）。"""
+    payload = {
+        "text": "联系 someone@example.com 或 13812345678",
+        "items": [{"mail": "a.b@example.org"}, {"tel": "13900001111"}],
+    }
+
+    out = sanitize_for_ai(payload)
+
+    assert "someone@example.com" not in str(out)
+    assert "13812345678" not in str(out)
+    assert "[EMAIL]" in str(out)
+    assert "[PHONE]" in str(out)
+    # 嵌套层也被处理
+    assert "a.b@example.org" not in str(out)
+
+
+def test_sanitize_leaves_numbers_and_booleans_untouched() -> None:
+    """非字符串原样返回。"""
+    payload = {"n": 42, "f": 1.5, "b": True, "none": None, "s": "plain text"}
+
+    out = sanitize_for_ai(payload)
+
+    assert out["n"] == 42
+    assert out["f"] == 1.5
+    assert out["b"] is True
+    assert out["none"] is None
+    assert out["s"] == "plain text"
+
+
+def test_sanitize_masks_the_spec_patterns() -> None:
+    """SPEC §3.2.1(3) 的三类：设备位号 / 项目编号 / 管线号。
+
+    ⚠️ **LINE_NO 先于 EQUIPMENT_TAG 匹配** —— 否则 `[A-Z]{2}-\\d{3}` 被
+    `[A-Z]{2,4}-\\d{3,5}` **完全遮蔽**（后者的字母/数字范围包含前者）
+    ⇒ `[LINE_NO]` 永远不会出现。
+    """
+    text = "位号 ABCD-1234 · 编号 1234.567.890 · 管线 AB-123"
+
+    out = sanitize_for_ai(text)
+
+    assert "[EQUIPMENT_TAG]" in out
+    assert "[PROJECT_NO]" in out
+    assert "[LINE_NO]" in out
+
+
+def test_person_name_mask_is_off_by_default() -> None:
+    """默认**不**遮中文人名（开了会把几乎每个中文词都遮掉）。"""
+    assert "[PERSON_NAME]" not in sanitize_for_ai("姓名：张三")
+
+
+def test_person_name_mask_can_be_enabled_at_runtime() -> None:
+    """enable_person_name_mask(True) ⇒ 遮；再关掉 ⇒ 不遮（**全局状态要能复位**）。"""
+    enable_person_name_mask(True)
+    try:
+        masked = sanitize_for_ai("姓名：张三")
+    finally:
+        enable_person_name_mask(False)
+
+    assert "[PERSON_NAME]" in masked
+    assert sanitize_for_ai("姓名：张三") == "姓名：张三"
+
+
+def test_hash_sanitized_is_stable_for_equal_bodies() -> None:
+    """同一 body 两次 ⇒ 同哈希（规范化：sort_keys + ensure_ascii=False）。
+
+    ⚠️ **键序不同也必须同哈希** —— 否则同一个请求重试会算出两个哈希
+    ⇒ 审计表里「同一次调用」对不上。
+    """
+    a = b'{"b": 2, "a": 1}'
+    b = b'{"a": 1, "b": 2}'
+
+    assert hash_sanitized(a) == hash_sanitized(b)
+    assert hash_sanitized(a).startswith("sha256:")
+
+
+def test_hash_sanitized_differs_for_different_bodies() -> None:
+    """不同 body ⇒ 不同哈希。"""
+    assert hash_sanitized(b'{"a": 1}') != hash_sanitized(b'{"a": 2}')
+
+
+def test_hash_sanitized_falls_back_to_raw_bytes_on_invalid_json() -> None:
+    """非 JSON ⇒ hash 原始 bytes（**不**记录内容）。"""
+    digest = hash_sanitized(b"not json at all")
+
+    assert digest.startswith("sha256:")
+    assert digest == hash_sanitized(b"not json at all")
+
+
+@pytest.mark.parametrize("body", [b"", b"[]", b'{"a": null}'])
+def test_hash_sanitized_handles_edge_bodies(body: bytes) -> None:
+    """边界 body（空 / 数组 / null）⇒ 也能算出稳定哈希，不抛。"""
+    assert hash_sanitized(body).startswith("sha256:")
+
+
+def test_hash_sanitized_ignores_the_sensitive_part() -> None:
+    """⚠️ **只差敏感字段的两个 body ⇒ 哈希相同**（M-1）。
+
+    ⇒ 该列才能用来判定「同一次脱敏调用」；且哈希不是**原文**的确定性函数。
+    """
+    a = b'{"text": "mail me at a@example.com"}'
+    b = b'{"text": "mail me at b@example.org"}'
+
+    assert hash_sanitized(a) == hash_sanitized(b)
+
+
+def test_hash_sanitized_still_distinguishes_different_payloads() -> None:
+    """脱敏后**内容不同** ⇒ 哈希仍不同（别把「同哈希」做成「全都同」）。"""
+    assert hash_sanitized(b'{"text": "x"}') != hash_sanitized(b'{"text": "y"}')
diff --git a/pcs-backend/tests/core/test_outbound_ai_client.py b/pcs-backend/tests/core/test_outbound_ai_client.py
new file mode 100644
index 0000000..0cf1eef
--- /dev/null
+++ b/pcs-backend/tests/core/test_outbound_ai_client.py
@@ -0,0 +1,130 @@
+"""`AINotImplementedError` + 全局 501 handler + `OutboundAIClient`（P10-A · Task T8）。
+
+## 这个模块的形状
+
+P10 阶段 AI **只做预留**：路由一律 501，但**审计链路是完整的** ——
+「AI 还没上线」≠「AI 调用不用留痕」。
+
+⇒ `OutboundAIClient.call()` 的顺序是**固定**的：
+① **调用时二次校验** endpoint（DNS 会漂移 ⇒ 启动时过了不代表此刻还成立）
+② 脱敏 ③ 审计 ④ 抛 `AINotImplementedError`（**不真调**）。
+
+## 三条容易写错的
+
+1. **审计失败不得抛** —— 否则「AI 调用因审计挂掉」⇒ 审计必须降级。
+2. **脱敏在审计之前** —— 审计里存的是**脱敏后**的载荷 ⇒ 审计表里不落原文。
+3. **端点校验在发出任何请求之前** —— 校验不过就**不许**有请求发出去。
+"""
+from __future__ import annotations
+
+import uuid
+
+import pytest
+from fastapi import FastAPI
+from httpx import ASGITransport, AsyncClient
+
+from app.core.ai_errors import AINotImplementedError
+from app.core.ai_sanitizer import sanitize_for_ai
+from app.core.errors import install_exception_handlers
+from app.core.outbound_ai_client import OutboundAIClient
+
+
+@pytest.fixture
+def ai_app() -> FastAPI:
+    """最小 app：只装全局异常处理器 + 一个抛 `AINotImplementedError` 的端点."""
+    app = FastAPI(title="PCS AI Test")
+    install_exception_handlers(app)
+
+    @app.get("/boom")
+    async def _boom() -> None:
+        raise AINotImplementedError()
+
+    return app
+
+
+async def test_ai_not_implemented_error_becomes_501_with_request_id(ai_app) -> None:
+    """抛 AINotImplementedError ⇒ 501 + 信封含 code/message/request_id。"""
+    transport = ASGITransport(app=ai_app)
+    async with AsyncClient(transport=transport, base_url="http://test") as ac:
+        resp = await ac.get("/boom")
+
+    assert resp.status_code == 501, resp.text
+    body = resp.json()
+    assert body["code"] == "AI_NOT_IMPLEMENTED"
+    assert body["message"]
+    # 没有中间件时也要有 request_id（回退成 uuid4）
+    uuid.UUID(body["request_id"])
+    # SPEC §4.1.1 的形状
+    assert body["status"] == "not_implemented"
+
+
+async def test_outbound_client_validates_endpoint_before_calling() -> None:
+    """endpoint 不在内网 CIDR ⇒ RuntimeError（**且没发出任何请求**）。"""
+    called: list[dict] = []
+
+    async def audit_fn(payload: dict) -> None:
+        called.append(payload)
+
+    client = OutboundAIClient(
+        endpoint="8.8.8.8", timeout=30, cidrs=["10.0.0.0/8"], audit_fn=audit_fn
+    )
+
+    with pytest.raises(RuntimeError):
+        await client.call({"text": "x"})
+
+    assert called == [], "校验没过就审计 ⇒ 顺序错了"
+
+
+async def test_outbound_client_sanitizes_payload_before_audit() -> None:
+    """进 `_audit` 的 payload 已脱敏（邮箱被替换）。
+
+    ⚠️ **靠注入的 `audit_fn` 观察** —— `_audit` 默认是 no-op ⇒ 没有别的观察点。
+    """
+    seen: list[dict] = []
+
+    async def audit_fn(payload: dict) -> None:
+        seen.append(payload)
+
+    client = OutboundAIClient(
+        endpoint="10.1.2.3", timeout=30, cidrs=["10.0.0.0/8"], audit_fn=audit_fn
+    )
+
+    with pytest.raises(AINotImplementedError):
+        await client.call({"text": "联系 someone@example.com"})
+
+    assert seen, "审计没被调用"
+    assert "someone@example.com" not in str(seen[0])
+    assert seen[0] == sanitize_for_ai({"text": "联系 someone@example.com"})
+
+
+async def test_outbound_client_raises_ai_not_implemented() -> None:
+    """P10 阶段：脱敏 + 审计后抛 AINotImplementedError（**不真调**）。"""
+    client = OutboundAIClient(
+        endpoint="10.1.2.3", timeout=30, cidrs=["10.0.0.0/8"]
+    )
+
+    with pytest.raises(AINotImplementedError):
+        await client.call({"text": "x"})
+
+
+async def test_outbound_client_audit_failure_does_not_propagate() -> None:
+    """⚠️ 审计写库失败**不得抛**（降级）—— 否则 AI 调用因审计挂掉。"""
+
+    async def broken_audit(payload: dict) -> None:
+        raise RuntimeError("审计库挂了")
+
+    client = OutboundAIClient(
+        endpoint="10.1.2.3", timeout=30, cidrs=["10.0.0.0/8"], audit_fn=broken_audit
+    )
+
+    # ⇒ 抛的是「未实现」，**不是**审计的 RuntimeError
+    with pytest.raises(AINotImplementedError):
+        await client.call({"text": "x"})
+
+
+async def test_outbound_client_without_audit_fn_still_works() -> None:
+    """没有注入 `audit_fn` 时 `_audit` 是 no-op（不炸）。"""
+    client = OutboundAIClient(endpoint="10.1.2.3", timeout=30, cidrs=["10.0.0.0/8"])
+
+    with pytest.raises(AINotImplementedError):
+        await client.call({"text": "x"})
diff --git a/pcs-backend/tests/scripts/test_compose_test_profile.py b/pcs-backend/tests/scripts/test_compose_test_profile.py
new file mode 100644
index 0000000..281ff30
--- /dev/null
+++ b/pcs-backend/tests/scripts/test_compose_test_profile.py
@@ -0,0 +1,141 @@
+"""`docker-compose.yml` 的 **test profile** 守卫（P10-A · Task T1）。
+
+为什么要有这个测试：compose 的 profile 语义是**静默**的 ——
+给一个服务加了 `profiles:` ⇒ `docker compose up` **不再起它** ⇒
+症状是「开发机连不上 Redis / LDAP」，而 compose 本身不报错。
+⇒ 这里把「哪些服务能进 profile、哪些绝对不能」钉成断言。
+
+⚠️ **日常开发服务绝不加 profile**（worker / openldap / postgres / redis）
+   —— 它们是 `docker compose up` 的默认启动集合，加了 profile 等于
+   悄悄改了既有开发流程。
+"""
+from __future__ import annotations
+
+from pathlib import Path
+
+import pytest
+import yaml
+
+#: 仓库根（tests/scripts/ → tests/ → pcs-backend/ → 根）
+REPO_ROOT = Path(__file__).resolve().parents[3]
+COMPOSE_FILE = REPO_ROOT / "docker-compose.yml"
+
+#: 日常开发必用的服务 —— **不得**进任何 profile。
+DAILY_DEV_SERVICES = ("postgres", "redis", "worker", "openldap", "openldap-seed")
+
+
+@pytest.fixture(scope="module")
+def compose() -> dict:
+    """解析 compose 文件（module 级 ⇒ 只解析一次）。"""
+    if not COMPOSE_FILE.exists():  # pragma: no cover — 仓库结构变了
+        pytest.fail(f"找不到 {COMPOSE_FILE}")
+    return yaml.safe_load(COMPOSE_FILE.read_text(encoding="utf-8"))
+
+
+def _services(compose: dict) -> dict:
+    return compose.get("services") or {}
+
+
+def test_seed_service_is_in_the_test_profile(compose: dict) -> None:
+    """`seed` 在 `profiles: ["test"]` 下 ⇒ 默认 `docker compose up` **不**起它。
+
+    ⚠️ 它是**一次性任务**（灌 E2E 种子数据）⇒ 默认启动只会白等一次。
+    """
+    services = _services(compose)
+    assert "seed" in services, "compose 里没有 `seed` 服务"
+    assert "test" in (services["seed"].get("profiles") or [])
+
+
+def test_seed_service_mounts_the_backend_source(compose: dict) -> None:
+    """⚠️ **seed 必须挂源码卷**（`./pcs-backend:/app`）
+    —— 否则容器里没有 `scripts/seed_e2e_data.py` ⇒ 立刻 FileNotFoundError。
+    """
+    volumes = _services(compose)["seed"].get("volumes") or []
+    mounts = [v if isinstance(v, str) else v.get("source", "") for v in volumes]
+    assert any("pcs-backend" in m for m in mounts), f"seed 没挂源码：{volumes}"
+
+
+def test_seed_uses_the_frozen_uv_entrypoint(compose: dict) -> None:
+    """⚠️ 与 `worker` 同款：`uv run --frozen`（不是裸 `python`）
+    ⇒ 依赖由 uv 装好，且版本与本地一致。
+
+    ⚠️ 裸 `python` 在 uv 官方镜像里**没有**项目依赖 ⇒ 立刻 ModuleNotFoundError。
+    """
+    command = _services(compose)["seed"].get("command") or []
+    joined = " ".join(command) if isinstance(command, list) else str(command)
+    assert "uv" in joined and "run" in joined and "--frozen" in joined, joined
+    assert "scripts/seed_e2e_data.py" in joined, joined
+
+
+def test_seed_depends_only_on_services_reachable_with_the_test_profile(
+    compose: dict,
+) -> None:
+    """⚠️ **depends_on 的每个依赖都要在 `--profile test` 下可达**
+    ⇒ `postgres-pgtest` 的 profiles 必须含 "test"
+    （否则 `--profile test` 起不出 seed —— compose 不会隐式启动
+    不在启用 profile 内的服务）。
+
+    没有 `profiles` 的服务 = **默认启动集合** ⇒ 永远可达。
+    """
+    services = _services(compose)
+    for dep in (services["seed"].get("depends_on") or {}):
+        assert dep in services, f"seed 依赖了不存在的服务 {dep}"
+        profiles = services[dep].get("profiles") or []
+        assert (not profiles) or ("test" in profiles), (
+            f"seed 依赖 {dep}，但它的 profiles={profiles} 不含 'test'"
+            f" ⇒ `--profile test` 起不出 seed"
+        )
+
+
+def test_seed_points_at_the_pgtest_database(compose: dict) -> None:
+    """⚠️ seed 连的是 `postgres-pgtest` 的库 **`pcs_pgtest`**（不是 `pcs_test`）。
+
+    连错库的后果：种子数据灌进**开发库** ⇒ 污染开发数据。
+    """
+    env = _services(compose)["seed"].get("environment") or {}
+    url = env.get("DATABASE_URL", "")
+    assert "postgres-pgtest" in url, url
+    assert "pcs_pgtest" in url, url
+
+
+def test_daily_dev_services_are_not_moved_into_a_profile(compose: dict) -> None:
+    """⚠️ **worker / openldap / postgres / redis 必须留在默认启动集合**
+    ⇒ 加了 profile 会让 `docker compose up` 不再起它们 ⇒ 破坏日常开发。
+    """
+    services = _services(compose)
+    for name in DAILY_DEV_SERVICES:
+        assert name in services, f"compose 里没有 {name} 服务"
+        assert not services[name].get("profiles"), (
+            f"{name} 被移进 profile {services[name]['profiles']}"
+            f" ⇒ `docker compose up` 不再起它 ⇒ 破坏日常开发"
+        )
+
+
+def test_migrate_service_is_in_the_test_profile(compose: dict) -> None:
+    """⚠️ **迁移**也得在 test profile 里（评审 H-2）。
+
+    ⇒ 测试库（`pcs_pgtest`）的 schema 由它升到 head ⇒
+    `seed` 才有表可写（否则 `relation "workspaces" does not exist`）。
+    """
+    services = _services(compose)
+    assert "migrate" in services, "compose 里没有 `migrate` 服务"
+    assert "test" in (services["migrate"].get("profiles") or [])
+
+
+def test_seed_runs_after_migrate(compose: dict) -> None:
+    """⚠️ `seed` 必须**等迁移完成** ⇒ 空 schema 上灌种子必然炸。"""
+    services = _services(compose)
+    depends = services["seed"].get("depends_on") or {}
+    assert "migrate" in depends, depends
+    assert depends["migrate"].get("condition") == "service_completed_successfully", depends
+
+
+def test_migrate_points_at_the_pgtest_database(compose: dict) -> None:
+    """⚠️ 迁移连的必须是**测试库** `pcs_pgtest`（不是开发库 `pcs`）。
+
+    连错 ⇒ **污染开发库**。
+    """
+    env = _services(compose)["migrate"].get("environment") or {}
+    url = env.get("DATABASE_URL", "")
+    assert "postgres-pgtest" in url, url
+    assert "pcs_pgtest" in url, url
