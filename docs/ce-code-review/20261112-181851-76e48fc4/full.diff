+        return HealthAIResponse(
+            status="degraded",
+            reason=_REASON_DOMAIN,
+            ai_enabled=ai_enabled,
+            endpoint_configured=True,
+            cidrs_configured=bool(cidrs),
+        )
+
+    if ip_in_cidrs(host, cidrs):
+        return HealthAIResponse(
+            status="ok",
+            reason=None,
+            ai_enabled=ai_enabled,
+            endpoint_configured=True,
+            cidrs_configured=bool(cidrs),
