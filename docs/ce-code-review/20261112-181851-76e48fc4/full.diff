@@ -0,0 +1,182 @@
+"""AI 审计的**入队**与**幂等写库**（P10-A · Task T10 · Review Focus #3）。
+
+## 为什么幂等是硬要求
+
+ARQ 默认 `max_tries=5`（本批不显式改）⇒ **重试必然发生** ⇒
+写库若不幂等 ⇒ 一次请求留下 **N 条**审计 ⇒ 审计表被灌水。
+⇒ 幂等测试**直接调它两次**来模拟重试（不依赖 ARQ 的重试机制）。
+
+## 两条容易写错的
+
+1. **PG 与 SQLite 的方言差异** —— `ON CONFLICT DO NOTHING` 在 SQLite 上
+   **不可用** ⇒ 单测库（内存 SQLite）必须走「先查后插 + catch
+   `IntegrityError`」分支 ⇒ 否则单测会炸或**永远绿**（见下）。
+2. **`IntegrityError` 分支在单线程里造不出来** —— 第二次调用时查询确实
+   查到了 ⇒ 走的是「跳过」分支 ⇒ 根本没碰 `IntegrityError`
+   ⇒ **假测试**。⇒ 必须 monkeypatch 掉查询，让它返回空（模拟「查的时候
+   不存在」），再让插入抛 `IntegrityError`（模拟「插的时候已经存在」）。
+"""
+from __future__ import annotations
+
+import uuid
+
+import pytest
+from sqlalchemy import func, select
+from sqlalchemy.exc import IntegrityError
+
+from app.models.system import AiAuditLog
+from app.services.ai.arq_queue import enqueue_ai_audit_log
+from app.workers.ai_audit_tasks import write_ai_audit_log
+
+
+def _fields(request_id: str | None = None) -> dict:
+    """一行 AI 审计的字段（形状与中间件组装的一致）。"""
+    return {
+        "request_id": request_id or str(uuid.uuid4()),
+        "client_request_id": None,
+        "endpoint": "/api/v1/ai/intent",
+        "status_code": 501,
+        "duration_ms": 3,
+        "sanitized_request_hash": "sha256:deadbeef",
+        "response_summary": "AI_NOT_IMPLEMENTED",
+        "model_version": None,
+        "user_id": None,
+    }
+
+
+@pytest.fixture
+def worker_ctx(db_engine) -> dict:
+    """ARQ ctx（带 session_factory）—— 与 `worker.py::_on_startup` 同款。"""
+    from sqlalchemy.ext.asyncio import async_sessionmaker
+
+    factory = async_sessionmaker(db_engine, expire_on_commit=False)
+    return {"session_factory": factory}
+
+
+async def _count(db) -> int:
+    return int((await db.execute(select(func.count()).select_from(AiAuditLog))).scalar_one())
+
+
+async def test_audit_write_is_idempotent(db_session, worker_ctx) -> None:
+    """⚠️ **Review Focus #3** —— 同一 request_id 写两次 ⇒ 只有一行。
+
+    （ARQ 默认 max_tries=5 ⇒ 重试必然发生 ⇒ 幂等不是「锦上添花」。）
+    """
+    fields = _fields()
+
+    await write_ai_audit_log(worker_ctx, **fields)
+    await write_ai_audit_log(worker_ctx, **fields)
+
+    assert await _count(db_session) == 1
+
+
+async def test_audit_write_creates_distinct_rows_for_distinct_requests(
+    db_session, worker_ctx
+) -> None:
+    """不同 request_id ⇒ 两行（幂等不是「只写一行」）。"""
+    await write_ai_audit_log(worker_ctx, **_fields())
+    await write_ai_audit_log(worker_ctx, **_fields())
+
+    assert await _count(db_session) == 2
+
+
+async def test_enqueue_failure_is_swallowed(monkeypatch) -> None:
+    """Redis 挂 ⇒ enqueue 返回 False，**不抛**（降级）。
+
+    ⚠️ 端点在业务链路上 ⇒ 入队失败抛 503 ⇒ **AI 端点会因为审计挂掉**
+    ⇒ 审计必须降级。
+    """
+    import app.services.ai.arq_queue as arq_queue
+
+    async def boom(*args, **kwargs):
+        raise RuntimeError("Redis 挂了")
+
+    monkeypatch.setattr(arq_queue, "_create_pool", boom)
+
+    assert await enqueue_ai_audit_log(**_fields()) is False
+
+
+async def test_task_is_registered_in_worker_functions() -> None:
+    """⚠️ ARQ 对**未注册**的函数名不报错 ⇒ job 静静躺着 ⇒ 棘轮会抓。
+
+    ⚠️ **与既有棘轮的关系**：仓里已有
+    `tests/workers/test_worker_registers_all_enqueued_tasks.py` 断言
+    「入队的 ⊆ 已注册的」（通用）；本条是**具体的**断言
+    （`write_ai_audit_log` 在 `WorkerSettings.functions` 里）⇒ 两条不重复。
+    """
+    from app.workers.worker import WorkerSettings
+
+    names = {fn.__name__ for fn in WorkerSettings.functions}
+    assert "write_ai_audit_log" in names, sorted(names)
+
+
+async def test_audit_write_swallows_integrity_error_on_sqlite(
+    db_session, worker_ctx, monkeypatch
+) -> None:
+    """⚠️ SQLite 分支是「先查后插」⇒ 并发下第二个插入抛 `IntegrityError`
+    ⇒ 必须 catch 掉，不算失败。
+
+    ⚠️ **单线程里造不出这个竞态** ⇒ 必须**显式构造**：monkeypatch 掉查询，
+    让它返回空（模拟「查的时候不存在」），再让插入抛 `IntegrityError`
+    （模拟「插的时候已经存在」）⇒ 断言 `write_ai_audit_log` **不抛**。
+    ⇒ 不这样构造的话，这条测试**永远绿** ⇒ **假测试**。
+    """
+    import app.workers.ai_audit_tasks as task_mod
+
+    await write_ai_audit_log(worker_ctx, **_fields())
+
+    # 让「查」永远查不到 ⇒ 走插入分支
+    async def fake_find_existing(*args, **kwargs):  # noqa: ANN002, ANN003, ANN201
+        return None
+
+    monkeypatch.setattr(task_mod, "_find_existing", fake_find_existing)
+
+    async def fake_insert_row(*args, **kwargs):  # noqa: ANN002, ANN003, ANN201
+        raise IntegrityError("INSERT ...", {}, Exception("UNIQUE constraint failed"))
+
+    monkeypatch.setattr(task_mod, "_insert_row", fake_insert_row)
+
+    # ⇒ 不抛
+    await write_ai_audit_log(worker_ctx, **_fields())
+    assert await _count(db_session) == 1
+
+
+def test_audit_write_uses_the_pg_conflict_clause_on_postgres() -> None:
+    """PG 分支走 `ON CONFLICT DO NOTHING`（方言级断言）。
+
+    ⚠️ 单测跑在内存 SQLite 上 ⇒ 直接断言**语句形状**（PG dialect 的
+    `ON CONFLICT ... DO NOTHING` + 冲突目标 `request_id`）。
+    """
+    from app.workers.ai_audit_tasks import _build_insert
+
+    stmt = _build_insert(
+        {
+            "agent_id": uuid.uuid4(),
+            "operation": "AI_REQUEST",
+            "request_id": "req-1",
+        },
+        is_postgres=True,
+    )
+
+    text = str(stmt)
+    assert "ON CONFLICT" in text
+    assert "request_id" in text
+    assert "DO NOTHING" in text
+
+
+def test_audit_write_falls_back_to_the_orm_insert_on_sqlite() -> None:
+    """非 PG ⇒ 走 ORM 的 `add()`（SQLite 上 `ON CONFLICT` 不可用）。"""
+    from app.models.system import AiAuditLog
+    from app.workers.ai_audit_tasks import _build_insert
+
+    row = _build_insert(
+        {
+            "agent_id": uuid.uuid4(),
+            "operation": "AI_REQUEST",
+            "request_id": "req-1",
+        },
+        is_postgres=False,
+    )
+
+    assert isinstance(row, AiAuditLog)
+    assert row.request_id == "req-1"
diff --git a/pcs-backend/tests/services/ai/test_ai_audit_task_pg.py b/pcs-backend/tests/services/ai/test_ai_audit_task_pg.py
new file mode 100644
index 0000000..a14c68b
--- /dev/null
+++ b/pcs-backend/tests/services/ai/test_ai_audit_task_pg.py
@@ -0,0 +1,247 @@
+"""AI 审计写库的**真 PG** 幂等（PG 车道 · P10-A · T10 的补充）。
+
+## 为什么单测不够
+
+单测跑在**内存 SQLite** 上 ⇒ 走的是「先查后插 + catch IntegrityError」
+那条分支 ⇒ **完全碰不到** PG 的 `INSERT ... ON CONFLICT`。
+⇒ 而 PG 那条分支**曾经是坏的**：`ON CONFLICT (request_id)` 匹配不到
+**partial** 唯一索引（`WHERE request_id IS NOT NULL`）⇒ PG 抛
+`InvalidColumnReferenceError: there is no unique or exclusion constraint
+matching the ON CONFLICT specification`
+⇒ **单测全绿、真库每次写审计都炸**。
+
+⚠️ 这正是本仓最怕的形状：**单测照绿、真库会炸**（CLAUDE.md「漂移盲区」）。
+⇒ 本文件把「PG 上写两次只有一行」钉死。
+
+## 手法（沿用 `tests/api/v1/test_stream_batch_concurrency_pg.py`）
+
+隔离 schema ⇒ 在它上面 `alembic upgrade head` ⇒ 用
+`options=-csearch_path=<schema>` 连过去 ⇒ 测完 `DROP SCHEMA ... CASCADE`
+⇒ 开发库一个字节都不动。
+
+⚠️ `pg` marker 的用例平时被 `pytest.skip` 静默跳过 ⇒ 绿灯**证明不了**
+它们跑过 ⇒ **必须**经 `scripts/pytest_pg.sh`（唯一入口）跑。
+"""
+from __future__ import annotations
+
+import os
+import subprocess
+import sys
+import uuid
+from pathlib import Path
+
+import pytest
+
+#: 本文件在 `tests/services/ai/`（与 `tests/api/v1/` 同深度）⇒
+#: `parents[3]` = `pcs-backend`（`alembic.ini` 与 `.env` 都在那儿）。
+#: ⚠️ 取 `parents[4]`（仓库根）⇒ 子进程 cwd 里**没有** `alembic.ini`
+#: ⇒ alembic 报「No 'script_location' key found in configuration」。
+ROOT = Path(__file__).resolve().parents[3]
+
+
+def _pg_url() -> str | None:
+    """PostgreSQL URL：`DATABASE_URL` 环境变量优先，否则 `.env`。"""
+    url = os.environ.get("DATABASE_URL")
+    if not url:
+        env_file = ROOT / ".env"
+        if env_file.exists():
+            from dotenv import dotenv_values
+
+            url = dotenv_values(env_file).get("DATABASE_URL")
+    return url if url and url.startswith("postgres") else None
+
+
+@pytest.mark.pg
+def test_ai_audit_write_is_idempotent_on_real_postgres():
+    """⚠️ **真 PG** 上写两次同一 `request_id` ⇒ 只有一行（不抛）。
+
+    ⚠️ 这条用例**曾经红过**：PG 的 `ON CONFLICT (request_id)` 匹配不到
+    partial 唯一索引 ⇒ 抛 `InvalidColumnReferenceError` ⇒ **每次写 AI 审计
+    都会炸**（而单测全绿）。
+    """
+    url = _pg_url()
+    if url is None:
+        pytest.skip(
+            "无 PostgreSQL URL —— 引擎级验证须经 scripts/pytest_pg.sh 跑（唯一入口）"
+        )
+
+    schema = f"iso_ai_audit_{uuid.uuid4().hex[:8]}"
+    scoped_url = url + ("&" if "?" in url else "?") + f"options=-csearch_path={schema}"
+    script = r'''
+import asyncio, os, uuid
+
+from sqlalchemy import func, select
+from sqlalchemy.ext.asyncio import async_sessionmaker, create_async_engine
+
+from app.models.system import AiAuditLog
+from app.workers.ai_audit_tasks import write_ai_audit_log
+
+
+async def main():
+    engine = create_async_engine(os.environ["DATABASE_URL"])
+    maker = async_sessionmaker(engine, expire_on_commit=False)
+    ctx = {"session_factory": maker}
+
+    def fields(request_id):
+        return {
+            "request_id": request_id,
+            "client_request_id": None,
+            "endpoint": "/api/v1/ai/intent",
+            "status_code": 501,
+            "duration_ms": 3,
+            "sanitized_request_hash": "sha256:deadbeef",
+            "response_summary": "AI_NOT_IMPLEMENTED",
+            "model_version": None,
+            "user_id": None,
+        }
+
+    req_a = str(uuid.uuid4())
+    # ⚠️ **写两次**（模拟重投）⇒ 不得抛、且只有一行
+    await write_ai_audit_log(ctx, **fields(req_a))
+    await write_ai_audit_log(ctx, **fields(req_a))
+
+    req_b = str(uuid.uuid4())
+    await write_ai_audit_log(ctx, **fields(req_b))
+
+    # ⚠️ **超长字段**（客户端可控）：`X-Request-ID` 可以是任意长度 ⇒
+    #    PG 的 `varchar(128)` 超长 ⇒ `22001 string_data_right_truncation`
+    #    ⇒ 若不截断 ⇒ **这一行审计被静默丢弃**（调用方毫无感知）
+    #    ⇒ 审计表对「用超长头探测」的行为**完全失明**。
+    req_c = str(uuid.uuid4())
+    long_fields = fields(req_c)
+    long_fields["client_request_id"] = "x" * 200
+    await write_ai_audit_log(ctx, **long_fields)
+
+    async with maker() as s:
+        count_a = (
+            await s.execute(
+                select(func.count()).select_from(AiAuditLog).where(
+                    AiAuditLog.request_id == req_a
+                )
+            )
+        ).scalar_one()
+        count_b = (
+            await s.execute(
+                select(func.count()).select_from(AiAuditLog).where(
+                    AiAuditLog.request_id == req_b
+                )
+            )
+        ).scalar_one()
+        count_c = (
+            await s.execute(
+                select(func.count()).select_from(AiAuditLog).where(
+                    AiAuditLog.request_id == req_c
+                )
+            )
+        ).scalar_one()
+        stored = (
+            await s.execute(
+                select(AiAuditLog.client_request_id).where(
+                    AiAuditLog.request_id == req_c
+                )
+            )
+        ).scalar_one_or_none()
+        total = (
+            await s.execute(select(func.count()).select_from(AiAuditLog))
+        ).scalar_one()
+
+    assert count_a == 1, f"同一 request_id 写了 {count_a} 行（应恰好 1 行）"
+    assert count_b == 1, f"另一个 request_id 写了 {count_b} 行"
+    assert count_c == 1, (
+        f"超长 client_request_id 让这一行审计**被丢弃**了（count={count_c}）"
+        " ⇒ 审计表对「用超长头探测」完全失明"
+    )
+    assert stored is not None and len(stored) <= 128, (
+        f"落库的 client_request_id 长度 {len(stored or '')} > 128 ⇒ 未截断"
+    )
+    assert total == 3, f"表里共 {total} 行（应恰好 3 行）"
+
+    await engine.dispose()
+    print("AI_AUDIT_PG_OK")
+
+
+asyncio.run(main())
+'''
