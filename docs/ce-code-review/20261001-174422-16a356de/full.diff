+        ),
+        sa.CheckConstraint(
+            "annual_consumption_kwh >= 0",
+            name="ck_utility_power_items_consumption_non_negative",
+        ),
+        sa.UniqueConstraint(
+            "project_id", "equipment_tag",
+            name="uq_utility_power_items_project_equipment_tag",
+        ),
