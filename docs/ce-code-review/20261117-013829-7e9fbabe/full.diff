diff --git a/pcs-backend/scripts/pytest_e2e.sh b/pcs-backend/scripts/pytest_e2e.sh
new file mode 100755
index 0000000..7168d30
--- /dev/null
+++ b/pcs-backend/scripts/pytest_e2e.sh
@@ -0,0 +1,35 @@
+#!/usr/bin/env bash
+# E2E 车道（隔离 schema · 真 PG）的唯一入口 —— P10-B。
+#
+# ## 定位
+#
+# 本脚本 = **薄封装**（复用 `scripts/pytest_pg.sh` 的三道 fail-closed 闸门）。
+# ⚠️ **不复制**那三道闸门 —— 复制 = 两份真相源 ⇒ 以后改闸门只改了一边
+# ⇒ 两条车道的行为悄悄分叉。
+#
+# ## 只做三件事
+#
+# ① `export PG_PYTEST_MARK=e2e` —— `pytest_pg.sh` 的 marker **已经参数化**
+#    ⇒ E2E 用例靠这个 marker 被选中（闸门②「收集到 0 个 ⇒ FAIL」因此有效）
+# ② `export PCS_E2E_LANE=1` —— **默认车道的 skip 闸门靠它放行**
+#    ⇒ 没有它，`uv run pytest` 会把 E2E 场景**跑到开发库 `pcs` 上**
+# ③ `exec bash scripts/pytest_pg.sh` —— 库 / 端口 / 三道闸门**全归它管**
+#
+# ## ⚠️ 不要在这里导 `DATABASE_URL` / `TEST_DATABASE_URL`
+#
+# `scripts/pytest_pg.sh:50-51` **无条件**覆写这两个变量 ⇒ 这里再导一次是
+# **死代码** ⇒ 留着会让人以为「改薄封装就能换库」⇒ 改了没效果 ⇒ 排查半天。
+#
+# ## ⚠️ 车道互斥
+#
+# 两条车道共用同一个库 ⇒ 并发跑会 DDL 等锁 ⇒ 表现是「偶发卡住」。
+# ⇒ 加锁放在**共享的** `pytest_pg.sh` 里（一次加锁 ⇒ 两条车道都生效，
+# 且本脚本 exec 进它 ⇒ 不会自己锁死自己）。
+set -euo pipefail
+
+cd "$(dirname "$0")/.."
+
+export PG_PYTEST_MARK=e2e
+export PCS_E2E_LANE=1
+
+exec bash scripts/pytest_pg.sh
diff --git a/pcs-backend/scripts/pytest_pg.sh b/pcs-backend/scripts/pytest_pg.sh
index 052f914..e545b84 100755
--- a/pcs-backend/scripts/pytest_pg.sh
+++ b/pcs-backend/scripts/pytest_pg.sh
@@ -37,20 +37,36 @@ fi
 
 # ① PG 实例必须起着
 # ⚠️ `-p` 可选但**语义必需**：设了它，「PG 没起」这条断言才能被单独触发
 #    （守卫测不到它声称的东西）。
 if ! docker compose -f "$COMPOSE_FILE" "${COMPOSE_PROJECT_ARGS[@]}" --profile pg ps --status running \
      | grep -q "postgres-pgtest"; then
   echo "FAIL: PG 测试实例未起 ⇒ docker compose --profile pg up -d" >&2
   exit 1
 fi
 
+# ⓛ 车道互斥锁（**不是** fail-closed 闸门，是并发保护）
+#
+# ⚠️ **PG 车道与 E2E 车道共用同一个库**（`pcs_pgtest`）⇒ 各自建隔离 schema
+#    ⇒ 并发跑 ⇒ DDL 互相等锁 ⇒ 表现是「**偶发卡住**」而不是报错
+#    ⇒ 排查成本极高 ⇒ 「别同时跑」必须是**机制**，不能只是一句叮嘱。
+#
+# ⚠️ **锁放在这个共享脚本里**（不是各自的薄封装里）⇒
+#    ① 一次加锁 ⇒ 两条车道都生效（E2E 车道 exec 进这里 ⇒ 一样被锁）
+#    ② 薄封装**不会**自己再抢一次 ⇒ 不会自己锁死自己。
+LOCK_FILE="${PCS_PGTEST_LANE_LOCK:-/tmp/pcs-pgtest-lane.lock}"
+exec 9>"$LOCK_FILE"
+if ! flock -n 9; then
+  echo "FAIL: 另一条车道（PG 车道 / E2E 车道）正在跑 ⇒ 同一个库不能并发建 schema" >&2
+  exit 1
+fi
+
 # 口令**只在环境变量里**（不上命令行 —— 会被权限分类器拦，且进 shell 历史）
 PG_USER="${POSTGRES_USER:-pcs}"
 PG_PASS="${POSTGRES_PASSWORD:-pcs_dev}"
 export DATABASE_URL="postgresql+psycopg://${PG_USER}:${PG_PASS}@localhost:${PG_PORT}/${PG_DB_NAME}"
 export TEST_DATABASE_URL="$DATABASE_URL"
 
 # ② 收集到的 PG 测试数必须 > 0
 # ⚠️ pytest 的 `-q --collect-only` 摘要是「N/M tests collected (K deselected)」
 #    —— 第一个数才是**选中**的（N），第二个是总数（M）⇒ 取第一个。
 collected="$(uv run pytest -m "$PG_PYTEST_MARK" --collect-only -q 2>/dev/null \
diff --git a/pcs-backend/scripts/seed_e2e_flows.py b/pcs-backend/scripts/seed_e2e_flows.py
new file mode 100644
index 0000000..efb66d8
--- /dev/null
+++ b/pcs-backend/scripts/seed_e2e_flows.py
@@ -0,0 +1,794 @@
+"""流程级 E2E 种子 —— P10-B（`scripts/seed_e2e_flows.py`）。
+
+## 它解决什么
+
+`scripts/seed_e2e_data.py`（P10-A）是**冒烟级**：4 个用户 · **项目内角色统一
+`DESIGNER`** ⇒ **测不了权限矩阵**（每个角色看到的东西一模一样 ⇒
+「越权 ⇒ 404」这类断言一条都写不出来）。
+
+⇒ 本种子只加**一个维度**：**角色矩阵**（per-user 的全局角色 × 项目内角色）
+⇒ **业务数据量不扩**（TODO-149 的结论：种子只够跑冒烟，但缺的是**角色维度**）。
+
+## 三条硬约束（每条都对应一类**静默**失败）
+
+1. **幂等** —— 跑第二遍不炸、不重复、不留脏数据。
+   不幂等的症状很隐蔽：E2E 第二次跑时表里多了一行 ⇒ 断言飘 ⇒
+   排查方向会跑到「业务代码有 bug」上，而真因是脚本没幂等。
+2. **只造起点态** —— 记录 = DRAFT、交付物 = DRAFT ⇒ **状态必须由场景走出来**
+   ⇒ 否则 E2E 只是断言一个「摆好的状态」⇒ 状态机坏了 E2E 也绿。
+3. **只删自己造的** —— `--reset` 按固定 UUID 列表筛 ⇒ 不碰业务数据。
+   ⚠️ **`users` 表一个都不删**（`user_id` 是**派生值**
+   `uuid5(NAMESPACE_DNS, username)` ⇒ 与真实 LDAP 账号的 id **完全相同**
+   ⇒ 按 id 删 = **删掉真实账号**（`roles` / `status` / `token_version` 全丢，
+   其 `user_projects` 授权行被 CASCADE）⇒ 而下次登录会把它**重建为 ACTIVE**
+   ⇒ **被停用的账号被悄悄启用**。
+
+## 授权行（`user_projects`）不是可选项
+
+带项目守卫的端点按「该用户对该项目**有没有授权行**」判定 ⇒
+没有授权行 ⇒ **一律 404**（与「不存在」逐字同形）⇒ E2E 看到的全是 404，
