 function useFetch<T>(path: string, initial: T): T {
   const [data, setData] = useState<T>(initial);
   useEffect(() => {
     let cancelled = false;
-    void fetch(path, { headers: { Authorization: DEV_BEARER } })
+    // ⚠️ **用会话里的真 token**（P10-B · T7 · bug-2169）——
