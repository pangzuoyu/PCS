+    "132-P-202A/B": {"扬程": 131.0, "效率": 0.75, "NPSHr": 6.0, "轴功率": 139.467,
+                     "电机额定功率": 185.0, "电机配用功率": 169.646, "转速": 2980.0},
+    "132-P-203A/B": {"扬程": 210.0, "效率": 0.48, "NPSHr": 3.0, "轴功率": 65.4595,
