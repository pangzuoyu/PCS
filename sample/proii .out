        SEQUENCE  STREAM=S3,CO2,S18,CAT
        PROCEDURE
        V(1)=SWR(S3)
        V(2)=SWR(CO2)
        V(3)=SWR(CAT)
        R(1)=(V(1)+V(2)+V(3))*11.5
         CALL SRXSTR(SWR,R(1),S18)
        RETURN
     MIXER UID=M2
        FEED S18,CAT,S3,CO2
        PRODUCT  M=S5
  
     REACTOR UID=R101
        FEED S5
        PRODUCT  M=S4
        OPERATION ADIABATIC, DP=0.5
        RXCALCULATION MODEL=STOIC,CONVERSION
       $ RXSTOIC RXSET=DMC1
      $ REACTION   CO2+PO--PC
        STOICHIOMETRY 11,-1/2,-1/3,1
        BASE COMPONENT=2
        CONVERSION 0.992
     $  REACTION   PC--AA+CO2
        STOICHIOMETRY 11,1/3,-1/9,1
        BASE COMPONENT=3
        CONVERSION 0.000076
     $  REACTION   PC+H2O--PG+CO2
        STOICHIOMETRY 11,1/3,-1/6,1/1,-1
        BASE COMPONENT=1
        CONVERSION 0.5
    $   REACTION    PO+H2O--12PG
        STOICHIOMETRY 2,-1/6,1/1,-1
        BASE COMPONENT=1
        CONVERSION 0.5
    HX  UID=E1
        HOT  FEED=S4, M=S1, DP=0.5
        OPER DUTY=0.18
  
     CALCULATOR UID=CA1,NAME=SET SP1 VALUE
        SEQUENCE  STREAM=S3,CO2,CAT
        PROCEDURE
        V(1)=SWR(S3)
        V(2)=SWR(CO2)

 SIMULATION SCIENCES INC.               R                              PAGE S-4
