 PROBLEM  Reactor Dist                   INPUT                     TIANXIAOLING
                                     SOURCE LISTING                    02/09/99
 ==============================================================================
 
        V(3)=SWR(CAT)
        R(1)=V(1)+V(2)+V(3)
        RETURN
  
     SPLITTER UID=SP1
        FEED S1
        PRODUCT M=S16,M=S17
        OPERATION OPTION=FILL
        SPEC STREAM=S17,RATE(WT,KG/H),DIVIDE,CALCULATOR=CA1,&
        R(1),VALUE=1
  
    HX  UID=E1A
        HOT  FEED=S16, M=S19, DP=0.5
        OPER HTEMP=135
  
     PUMP UID=P1
        FEED S19
        PRODUCT M=S18
        OPERATION EFF=50,DP=1.2
  
    FLASH UID=F2
        FEED S17
        PRODUCT L=S23,V=S22
        ADIABATIC PRES=2.3
  
    HX UID=E2
        HOT FEED=S22,V=S24,L=S25,DP=0.3
        OPER HTEMP=40
  
    COLUMN UID=T102
       PARAMETER TRAY=12,IO=100
       FEED S23,9,SEPA/S25,9,SEPA
       PRODUCT OVHD(WT)=A2,10,BTMS(WT)=B2,202,&
               LDRAW=C2,7,14.72
       CONDENSER TYPE=PART, PRESSURE(MMHG)=60, TEST=60
       DUTY 1,1/2,12
       PSPEC PTOP(MMHG)=65, DPCOLUMN(MMHG)=15
       PRINT COMPOSITION=M,WT, PROPTABLE=PART
       ESTIMATE MODEL=SIMPLE, RRATIO=2, CTEMP=60, TTEMP=114, RTEMP=190
       TEMPERATURE 1,60/2,114/12,190
     $ SPEC STRM=S26,COMP=6,RATE,RATIO,REFF,VALUE=0.005,ATOL=0.001
     $ SPEC STRM=S27,RATE,DIVIDE,STRM=S28,RATE,VALUE=4
       SPEC COLUMN=T102, TRAY=1, TEMPERATURE(C), VALUE=60
       SPEC TRAY=7,PHASE=L,RATE(KG/H),VALUE=125
      $ SPEC STRM=B2,COMP=6,RATE,RATIO REFF,VALUE=0.005,ATOL=0.001
      $ SPEC RRATIO,PHASE=L,VALUE=60
      $ SPEC STRM=B2,RATE(KG/H),VALUE=300,ATOL=0.01
       VARY DUTY=1,2
       TFLOW NET(V)=PV2,2,NET(L)=PL2,1
       TFLOW PA(L)=PF2,12,12
       PA FROM=12,TO=12,LFRAC=0.8,PHASE=L
       TSIZE
  

 SIMULATION SCIENCES INC.               R                              PAGE S-5
