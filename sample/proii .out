    $  OPTIMIZER UID=OPI1
    $    OBJEC COLUMN=T102,DUTY(2),MINIMIZE
    $    VARY COLUMN=T102,FTRAY(1),MINI=4,MAXI=11,STEP=1
  
  
    HX UID=E02
        HOT FEED=PV2,L=P2,DP(MMHG)=5
        DEFINE DUTY AS COLUMN=T102 DUTY(1)
  
    HCURVE UID=H02
        ISO HX=E02 POINT=5 HOT
  
    PUMP UID=P3
        FEED C2
        PRODUCT M=S29
        OPERATION EFF=50,DP=3.8
  
   HX UID=E3
        HOT FEED=S29,M=S30,DP=0.3
        OPER HTEMP=40
  
   MIXER UID=M3
        FEED S30,ME,ME1,S50
        PRODUCT  M=S31
  
   HX UID=E4
        COLD FEED=S31,M=S31A,DP=0.3
        OPER CTEMP=70
  
    CSTR UID=R1
        FEED S31A
        PRODUCT M=S32
        OPERATION PHASE=L,VOLUME=1.4,ADIABATIC,DP=0.2
        PRINT PATH
        RXSTOIC RXSET=DMC
      REACTION DMC+
        BASE COMPONENT=3
      REACTION DMC-
        BASE COMPONENT=3
  
 ** WARNING **  UNIT 26, 'R1' - REACTION PRODUCT 3 SPECIFIED AS A BASE
                COMPONENT FOR REACTION 2. REACTOR CALCULATIONS MAY FAIL.
    HX UID=E4A
        COLD FEED=S32,M=S32A,DP=0
        OPER CTEMP=74.3
  
    REACTOR UID=R2
       FEED S32A
       PRODUCT  M=S33
       OPERATION ADIABATIC,DP=0
       RXCALCULATION MODEL=STOIC,CONVERSION
   $   REACTION  12PG+ME--MOX+H2O
       STOICHIOMETRY 1,1/4,-1/6,-1/12,1

 SIMULATION SCIENCES INC.               R                              PAGE S-6
