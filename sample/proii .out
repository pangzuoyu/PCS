       BASE COMPONENT=6
       CONVERSION 0.0254
   $   REACTION  2*12PG--DPG+H2O
       STOICHIOMETRY 1,1/6,-2/7,1
       BASE COMPONENT=6
       CONVERSION 0.0254
  
     REACTOR UID=R3
       FEED S33
       PRODUCT  M=S34
       OPERATION ADIABATIC,DP=0
       RXCALCULATION MODEL=STOIC,CONVERSION
   $   RXSTOIC RXSET=DMCM
   $   REACTION  PC+H2O--12PG+CO2
       STOICHIOMETRY 6,1/11,1/1,-1/3,-1
       BASE COMPONENT=1
       CONVERSION 0.40
  
     STCA UID=S2
       FEED S34
       OVHD STRM=S34A
       BTMS STRM=S34B
       FOVH 11,11,1.0/1,1,0.77/2,10,0/12,14,0
  
    COLUMN UID=RXD1
       PARAMETER TRAY=28,CHEMDIST=120,DAMPING=0.7
       FEED S34B,9/ME2,11,SEPA/ME3,28,SEPA
       PRODUCT  OVHD(WT)=A3,0.1, BTMS(WT)=B3,1690,&
                VDRAW(WT)=C3,2,4500
       CONDENSER TYPE=BUBB,PRES=1.013,TEST=63.5
       DUTY 1,1,-0.30/2,28,1.25
       PSPEC PTOP=1.313,DPCOLUMN=0.5
       PRINT COMPOSITION=WT,PROPTABLE=PART
       ESTIMATE MODEL=CHEM, RRATIO(L)=2, TTEMP=63.5, RTEMP=110
       TEMPERATURE 2,70.3/8,72.8/9,76.9/27,82.8/28,112
       LIQUD 2,24/8,23.1/9,132.7/27,160.5
     $ SPEC STRM=B3,RATE(WT),VALUE=1690,ATOL=0.001
       SPEC STRM=A3,RATE(WT),VALUE=0.01,ATOL=0.001
       SPEC STREAM=B3,COMP=5,RATE,RATIO,REFF,VALUE=0.05
       VARY DUTY=2
       VARY DRAW=C3
       LVOL  9,3.5/10,3.5/11,2/12,2/13,1/14,1/15,1/16,1/17,1/18,1/19,1/&
             20,1/21,1/22,1/23,1/24,1/25,1/26,1/27,1
       RXTRAY REFERENCE=DMC,LOCAL=COL1RXD1,TRAY=9,24
       RXSET LOCAL=COL1RXD1
         REACTION ID=DMC+,COPTION=KINETICS
         REACTION ID=DMC-,COPTION=KINETICS
         RXPARAM VITER=10,VINIT=0.5
      $   TSIZE
  
    CALCULATOR UID=CA5,NAME=SET SP1 VALUE
        SEQUENCE  STREAM=C3,PC
        PROCEDURE

