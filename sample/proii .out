  DIMENSION METRIC, STDTEMP=0, STDPRES=1.03323
  SEQUENCE DEFINED=T1,E1,E3,E2,P1,T2
  CALCULATION RVPBASIS=APIN, TVP=37.778, RECYCLE=ALL
COMPONENT DATA
  LIBID 1,NH3/2,H2O
THERMODYNAMIC DATA
  METHOD SYSTEM=SRKS, TRANSPORT=PURE, DIFFUSIVITY=PRED, SET=SRKS01, &
         DEFAULT
STREAM DATA
  PROPERTY STREAM=S1, TEMPERATURE=40, PRESSURE=20, PHASE=M, &
         RATE(WT)=10000, COMPOSITION(WT)=1,2000/2,8000, NORMALIZE
  PROPERTY STREAM=S5, TEMPERATURE=40, PRESSURE=2, PHASE=M, &
         RATE(M)=2000, COMPOSITION(M)=1,2000/2,20
UNIT OPERATIONS
  COLUMN UID=T1
      PARAMETER TRAY=20,SURE=20 CAVE=3
      FEED S8,4
      PRODUCT  OVHD(WT)=S2,2000, BTMS(WT)=S3,7999.99, SUPERSEDE=OFF
      CONDENSER TYPE=PART, PRESSURE=20, TEST=100
      DUTY 1,1/2,20
      PSPEC PTOP=20
      PRINT COMPOSITION=M,WT, PROPTABLE=ALL, &
                 RECOVERY, DIAGRAM, TLOADING
      ESTIMATE MODEL=SIMPLE, RRATIO=15, CTEMP=100, TTEMP=210, &
                 BTEMP=220, RTEMP=220
      TEMPERATURE 2,210/19,220/20,220
      VAPOR(WT) 1,1800/20,2000
      LIQUID(L,M) 1,1000/20,7999.99
      SPEC STREAM=S2,FRACTION(WT), PHASE=V, COMP=1, VALUE=0.995
      SPEC STREAM=S3,PPM(WT), COMP=1, VALUE=100
      VARY DUTY=2,1
      REBOILER TYPE=KETTLE
      METHOD SET=SRKS01
  HX   UID=E1
      HOT  FEED=S2, M=S4
      UTILITY WATER, TIN=33, TEMPERATURE=38
      CONFIGURE COUNTER
      OPER HTEMP=40
  HX   UID=E3
      HOT  FEED=S3, M=S9
      COLD FEED=S7, M=S8
      CONFIGURE COUNTER
      OPER HTEMP=150
  HX   UID=E2
      HOT  FEED=S9, M=S10
      UTILITY WATER, TIN=30, TEMPERATURE=40
      CONFIGURE COUNTER
      OPER HTEMP=40
  PUMP UID=P1
      FEED S1
      PRODUCT  M=S7
      OPERATION PRESSURE=15
  COLUMN UID=T2
      PARAMETER TRAY=10,IO
      FEED S5,10/S10,1
      PRODUCT  BTMS(WT)=S1,10000, OVHD(WT)=S6,10
      PSPEC PTOP=2
      PRINT PROPTABLE=PART
      SPEC STREAM=S6,PPM, COMP=1, VALUE=1
      VARY FEED=S5
RECYCLE DATA
  ACCELERATION TYPE=WEGSTEIN
END

