
  TITLE PROJECT=DMC, PROBLEM=Reactor Dist, USER=TIANXIAOLING,SITE=ZH
   $PRINT INPUT=ALL, STREAM=ALL$ PERCENT=M,WT, ION=NONE
   PRINT STREAM=ALL, PERCENT=M,wt,rate=m,wt,ION=NONE
   DIMENSION METRIC, STDTEMP=0, STDPRES=1.03323
   TOLER TEMP=0.1
 COMPONENT DATA
   LIBID 1,H2O/2,PO/3,PROPCARB/4,METHANOL/5,DMCARB/6,12PG/7,DIPRPGLY/ &
         8,TPG/9,AA/10,OXYLENE/11,CO2/12,MOXYPROH/13,H2/14,PROPALD
  
  THERMODYNAMIC DATA
  METHOD SET=1,DEFAULT,SYSTEM=NRTL3,ENTH=LIBR, ENTROPY(L)=SRK,&
          ENTROPY(V)=SRK,TRANSPORT=PURE ,DENSITY(L)=API
          $KVAL(VLLE), FILL=UNIF,POYNTING=ON
          KVAL(VLE), FILL=UNIF,POYNTING=ON
  $METHOD SET=2, SYSTEM=NRTL, ENTROPY(L)=SRK, ENTROPY(V)=SRK,&
   $     TRANSPORT=PURE
    $    KVAL(VLE) POYNTING=ON, FILL=UNIF
    $  NRTL3 10,5,-1511.69,172.515,0.9
    $  NRTL3 1,6,-169.203,190.183,-0.757526
       NRTL3 4,5,243.035,158.026,-0.0207718
    $  NRTL3 4,6,128.646,-301.463,0.20487
    $  NRTL3 4,10,257.485,1368.09,0.220308
  
 STREAM DATA
   PROPERTY STREAM=S3, TEMPERATURE=40, PRESSURE=40, PHASE=M, &
          RATE(w)=860, COMPOSITION(M)=1,0.01/2,99.9/14,0.09, NORMALIZE
   PROPERTY STREAM=S8, TEMPERATURE=65, PRESSURE=1.1, PHASE=M, &
          RATE(M)=44, COMPOSITION(M)=1,20.85/11,78.41/13,0.74,&
          NORMALIZE
   PROPERTY STREAM=S18, TEMPERATURE=125, PRESSURE=40.5, PHASE=M,  &
         RATE(M)=204, COMPOSITION(M)=2,0.0668/3,95.211/6,0.008/ &
         9,0.008/11,3.843/13,0.778/14,0.05, NORMALIZE
  PROPERTY STREAM=CAT, TEMPERATURE=40, PRESSURE=40, PHASE=M, &
          RATE(M)=30, COMPOSITION(M)=3,20, NORMALIZE
  PROPERTY STREAM=ME, TEMPERATURE=40, PRESSURE=3.0, PHASE=M, &
         RATE(W)=950, COMPOSITION(M)=1,0.1/4,99.9, NORMALIZE
  PROPERTY STREAM=ME1, TEMPERATURE=60, PRESSURE=3.0, PHASE=M, &
         RATE(W)=2303.36, COMPOSITION(M)=3,0.0034/4,98.5762/&
                          5,1.4206, NORMALIZE
  PROPERTY STREAM=ME2, TEMPERATURE=64, PRESSURE=3.0, PHASE=M, &
         RATE(W)=688, COMPOSITION(M)=3,0.0034/4,98.5762/&
                      5,1.4206, NORMALIZE
  PROPERTY STREAM=ME3, TEMPERATURE=40, PRESSURE=3.0, PHASE=M, &
         RATE(W)=320.8, COMPOSITION(M)=4,88/5,12, NORMALIZE
  PROPERTY STREAM=PC, TEMPERATURE=40, PRESSURE=1.4, PHASE=M, &
         RATE(WT)=6576,COMPOSITION=3,100, NORMALIZE$158.344, 
  PROPERTY STREAM=PC1, TEMPERATURE=40, PRESSURE=1.4, PHASE=M, &
         RATE(WT)=6576,COMPOSITION=3,100, NORMALIZE$158.344, 
  PROPERTY STREAM=S50, TEMPERATURE=130, PRESSURE=3.5, PHASE=M, &
         RATE(WT)=225,COMPOSITION=1,0.0299/3,1.4744/4,0.3558/&
         5,0.0827/6,94.6999/7,3.3207/12,0.1267 NORMALIZE
  
 
  RXDATA
  RXSET ID=DMC
  REACTION ID=DMC+
    STOICHIOMETRY 3,-1/4,-2/5,1/6,1
    HORX HEAT=-2.1978,REFCOMP=3,REFTEMP=25,REFPHASE=L
    KINETICS PEXP(MIN,G,LIT)=9785,ACTIVATION=9.615,TEXPONENT=0
    KORDER 3,1/4,1/5,0/6,0
  REACTION ID=DMC-
    STOICHIOMETRY 3,1/4,2/5,-1/6,-1
    HORX HEAT=2.1978,REFCOMP=3,REFTEMP=25,REFPHASE=L
    KINETICS PEXP(MIN)=1.9723E6,ACTIVATION=11.771,TEXPONENT=0
    KORDER 3,0/4,-1/5,1/6,1

   UNIT OPERATIONS  
    CALCULATOR UID=CA2
       SEQUENCE  STREAM=S3,S8,CAT
       PROCEDURE
       V(1)=SMR(S3)
       R(1)=V(1)*1.05/0.7841
       CALL SRXSTR(SMR,R(1),S8)
       R(2)=V(1)/100*20
       CALL SRXSTR(SMR,R(2),CAT)
       RETURN
  
    HX  UID=E0
       HOT  FEED=S8, M=S6, DP=0.1
       OPER HTEMP=40

    FLASH UID=F1
       FEED S6
       PRODUCT  V=S7, W=S13 
       ADIABATIC

    COMPRESSOR UID=C1
       FEED S7
       PRODUCT  V=S9, L=S10
       OPERATION CALCULATION=ASME, PRES=3.61 
       COOLER ACDP=0.2, ACTEMP=40
 
   COMPRESSOR UID=C2
       FEED S9
       PRODUCT  V=S11, L=S12
       OPERATION CALCULATION=ASME, PRES=11.83
       COOLER ACDP=0.2, ACTEMP=40

   COMPRESSOR UID=C3
       FEED S11
       PRODUCT  M=S14 
       OPERATION CALCULATION=ASME, PRES=60.4 
      $ COOLER ACDP=0.2, ACTEMP=40
  
   HX  UID=EC3
       HOT  FEED=S14, L=S15,V=S15A, DP=0.2
       OPER HTEMP=40
  
   STCA UID=S1
       FEED S15A
       OVHD STRM=S20,TEMP=40,DP=0.2
       BTMS STRM=CO2,TEMP=40,DP=0.2
       FOVH 1,1,0.99/2,14,0

    CALCULATOR UID=CA3
       SEQUENCE  STREAM=S3,CO2,S18,CAT
       PROCEDURE
       V(1)=SWR(S3)
       V(2)=SWR(CO2)
       V(3)=SWR(CAT)
       R(1)=(V(1)+V(2)+V(3))*11.5
        CALL SRXSTR(SWR,R(1),S18)
       RETURN
    MIXER UID=M2
       FEED S18,CAT,S3,CO2
       PRODUCT  M=S5
  
    REACTOR UID=R101
       FEED S5
       PRODUCT  M=S4
       OPERATION ADIABATIC, DP=0.5
       RXCALCULATION MODEL=STOIC,CONVERSION
      $ RXSTOIC RXSET=DMC1
     $ REACTION   CO2+PO--PC
       STOICHIOMETRY 11,-1/2,-1/3,1
       BASE COMPONENT=2
       CONVERSION 0.992
    $  REACTION   PC--AA+CO2
       STOICHIOMETRY 11,1/3,-1/9,1
       BASE COMPONENT=3
       CONVERSION 0.000076
    $  REACTION   PC+H2O--PG+CO2
       STOICHIOMETRY 11,1/3,-1/6,1/1,-1
       BASE COMPONENT=1
       CONVERSION 0.5 
   $   REACTION    PO+H2O--12PG
       STOICHIOMETRY 2,-1/6,1/1,-1
       BASE COMPONENT=1
       CONVERSION 0.5
   HX  UID=E1
       HOT  FEED=S4, M=S1, DP=0.5
       OPER DUTY=0.18

    CALCULATOR UID=CA1,NAME=SET SP1 VALUE
       SEQUENCE  STREAM=S3,CO2,CAT
       PROCEDURE
       V(1)=SWR(S3)
       V(2)=SWR(CO2)
       V(3)=SWR(CAT)
       R(1)=V(1)+V(2)+V(3)
       RETURN
    
    SPLITTER UID=SP1
       FEED S1
       PRODUCT M=S16,M=S17
       OPERATION OPTION=FILL
       SPEC STREAM=S17,RATE(WT,KG/H),DIVIDE,CALCULATOR=CA1,&
       R(1),VALUE=1

   HX  UID=E1A
       HOT  FEED=S16, M=S19, DP=0.5
       OPER HTEMP=135

    PUMP UID=P1
       FEED S19
       PRODUCT M=S18
       OPERATION EFF=50,DP=1.2

   FLASH UID=F2
       FEED S17
       PRODUCT L=S23,V=S22
       ADIABATIC PRES=2.3

   HX UID=E2
       HOT FEED=S22,V=S24,L=S25,DP=0.3
       OPER HTEMP=40
       
   COLUMN UID=T102
      PARAMETER TRAY=12,IO=100
      FEED S23,9,SEPA/S25,9,SEPA
      PRODUCT OVHD(WT)=A2,10,BTMS(WT)=B2,202,&
              LDRAW=C2,7,14.72               
      CONDENSER TYPE=PART, PRESSURE(MMHG)=60, TEST=60
      DUTY 1,1/2,12
      PSPEC PTOP(MMHG)=65, DPCOLUMN(MMHG)=15
      PRINT COMPOSITION=M,WT, PROPTABLE=PART
      ESTIMATE MODEL=SIMPLE, RRATIO=2, CTEMP=60, TTEMP=114, RTEMP=190
      TEMPERATURE 1,60/2,114/12,190
    $ SPEC STRM=S26,COMP=6,RATE,RATIO,REFF,VALUE=0.005,ATOL=0.001
    $ SPEC STRM=S27,RATE,DIVIDE,STRM=S28,RATE,VALUE=4   
      SPEC COLUMN=T102, TRAY=1, TEMPERATURE(C), VALUE=60
      SPEC TRAY=7,PHASE=L,RATE(KG/H),VALUE=125
     $ SPEC STRM=B2,COMP=6,RATE,RATIO REFF,VALUE=0.005,ATOL=0.001
     $ SPEC RRATIO,PHASE=L,VALUE=60
     $ SPEC STRM=B2,RATE(KG/H),VALUE=300,ATOL=0.01
      VARY DUTY=1,2     
      TFLOW NET(V)=PV2,2,NET(L)=PL2,1
      TFLOW PA(L)=PF2,12,12
      PA FROM=12,TO=12,LFRAC=0.8,PHASE=L
      TSIZE  
     
   $  OPTIMIZER UID=OPI1
   $    OBJEC COLUMN=T102,DUTY(2),MINIMIZE
   $    VARY COLUMN=T102,FTRAY(1),MINI=4,MAXI=11,STEP=1
 
   
   HX UID=E02
       HOT FEED=PV2,L=P2,DP(MMHG)=5
       DEFINE DUTY AS COLUMN=T102 DUTY(1)

   HCURVE UID=H02
       ISO HX=E02 POINT=5 HOT
       
   PUMP UID=P3
       FEED C2
       PRODUCT M=S29
       OPERATION EFF=50,DP=3.8

  HX UID=E3
       HOT FEED=S29,M=S30,DP=0.3
       OPER HTEMP=40

  MIXER UID=M3
       FEED S30,ME,ME1,S50
       PRODUCT  M=S31

  HX UID=E4
       COLD FEED=S31,M=S31A,DP=0.3
       OPER CTEMP=70
  
   CSTR UID=R1
       FEED S31A
       PRODUCT M=S32
       OPERATION PHASE=L,VOLUME=1.4,ADIABATIC,DP=0.2 
       PRINT PATH  
       RXSTOIC RXSET=DMC
     REACTION DMC+
       BASE COMPONENT=3
     REACTION DMC-
       BASE COMPONENT=3

   HX UID=E4A
       COLD FEED=S32,M=S32A,DP=0
       OPER CTEMP=74.3

   REACTOR UID=R2
      FEED S32A
      PRODUCT  M=S33
      OPERATION ADIABATIC,DP=0
      RXCALCULATION MODEL=STOIC,CONVERSION
  $   REACTION  12PG+ME--MOX+H2O
      STOICHIOMETRY 1,1/4,-1/6,-1/12,1
      BASE COMPONENT=6
      CONVERSION 0.0254
  $   REACTION  2*12PG--DPG+H2O
      STOICHIOMETRY 1,1/6,-2/7,1
      BASE COMPONENT=6
      CONVERSION 0.0254

    REACTOR UID=R3
      FEED S33
      PRODUCT  M=S34
      OPERATION ADIABATIC,DP=0
      RXCALCULATION MODEL=STOIC,CONVERSION
  $   RXSTOIC RXSET=DMCM
  $   REACTION  PC+H2O--12PG+CO2
      STOICHIOMETRY 6,1/11,1/1,-1/3,-1
      BASE COMPONENT=1
      CONVERSION 0.40
  
    STCA UID=S2
      FEED S34
      OVHD STRM=S34A
      BTMS STRM=S34B
      FOVH 11,11,1.0/1,1,0.77/2,10,0/12,14,0
                 
   COLUMN UID=RXD1
      PARAMETER TRAY=28,CHEMDIST=120,DAMPING=0.7
      FEED S34B,9/ME2,11,SEPA/ME3,28,SEPA
      PRODUCT  OVHD(WT)=A3,0.1, BTMS(WT)=B3,1690,&
               VDRAW(WT)=C3,2,4500
      CONDENSER TYPE=BUBB,PRES=1.013,TEST=63.5
      DUTY 1,1,-0.30/2,28,1.25
      PSPEC PTOP=1.313,DPCOLUMN=0.5
      PRINT COMPOSITION=WT,PROPTABLE=PART
      ESTIMATE MODEL=CHEM, RRATIO(L)=2, TTEMP=63.5, RTEMP=110
      TEMPERATURE 2,70.3/8,72.8/9,76.9/27,82.8/28,112
      LIQUD 2,24/8,23.1/9,132.7/27,160.5
    $ SPEC STRM=B3,RATE(WT),VALUE=1690,ATOL=0.001
      SPEC STRM=A3,RATE(WT),VALUE=0.01,ATOL=0.001
      SPEC STREAM=B3,COMP=5,RATE,RATIO,REFF,VALUE=0.05
      VARY DUTY=2
      VARY DRAW=C3
      LVOL  9,3.5/10,3.5/11,2/12,2/13,1/14,1/15,1/16,1/17,1/18,1/19,1/&
            20,1/21,1/22,1/23,1/24,1/25,1/26,1/27,1
      RXTRAY REFERENCE=DMC,LOCAL=COL1RXD1,TRAY=9,24
      RXSET LOCAL=COL1RXD1
        REACTION ID=DMC+,COPTION=KINETICS 
        REACTION ID=DMC-,COPTION=KINETICS
        RXPARAM VITER=10,VINIT=0.5  
     $   TSIZE 
    
   CALCULATOR UID=CA5,NAME=SET SP1 VALUE
       SEQUENCE  STREAM=C3,PC
       PROCEDURE
       V(1)=SMR(C3)
       R(1)=V(1)*0.5
       CALL SRXSTR(SMR,R(1),PC)
       RETURN

  $ PUMP UID=P4
   $    FEED A3
    $   PRODUCT M=S35
     $  OPERATION EFF=50,DP=2
 
     COLUMN UID=T104
       PARAMETER TRAY=80,IO=100,DAMPING=0.8
       FEED C3,56/PC,4
       PRODUCT  OVHD(WT)=A4,3012.93, BTMS(WT)=B4
       CONDENSER TYPE=BUBB,PRES=0.507
       DUTY 1,1,-1.7/2,80,1.05
       PSPEC PTOP=0.531, DPCOLUMN=0.04
       PRINT COMPOSITION=M,WT, PROPTABLE=PART
       ESTIMATE MODEL=CONV, RRATIO=0.5, CTEMP=40, BTEMP=106
       TEMPERATURE 1,40.8/2,50/80,106
      $ LIQUiD 1,47/2,45.3/3,114.1/59,131.3
      $vapor 2,141/3,139.3/4,147.8/53,158.4/54,47.9/55,48.1
      $  SPEC COLUMN=T104, TRAY=1, TEMPERATURE(C), VALUE=30
       $ SPEC STREAM=A4, COMP=4, RATE(W),VALUE=3012.94
       SPEC STREAM=A4, COMP=4, RATE,RATIO,REFF,VALUE=1
       SPEC RRATIO VALUE=0.6
       TFLOW NET(V)=PV4,2,NET(L)=PL4,1
       TFLOW PA(L)=PF4,80,80
       PA FROM=80,TO=80,LFRAC=0.8,PHASE=L
       VARI HEAT=1,2
       TSIZE
   
     $ OPTIMIZER UID=OPI1
     $ OBJEC COLUMN=T104,DUTY(2),MINIMIZE
     $ VARY COLUMN=T104,FTRAY(1),MINI=20,MAXI=58,STEP=1
 
     
   HX UID=E04
       HOT FEED=PV4,L=P4,DP=0.2
       DEFINE DUTY AS COLUMN=T104 DUTY(1)

   HCURVE UID=H04
       ISO HX=E04 POINT=5 HOT
   
  
  COLUMN UID=T105
      PARAMETER TRAY=10,IO=100
      FEED B4,5
      PRODUCT  OVHD(WT)=A5,1190, BTMS(WT)=B5
      CONDENSER TYPE=BUBB,PRES(MMHG)=65
      DUTY 1,1/2,10 
      PSPEC PTOP(MMHG)=80 , DPCOLUMN(MMHG)=20
 $     PRINT COMPOSITION=M,WT, PROPTABLE=PART
      ESTIMATE MODEL=CONV, RRATIO=1, CTEMP=70, BTEMP=190
      &TEMPERATURE 1,80/2,150/19,160                  
     $ SPEC STREAM=A2,COMP=4,PERCENT(M),VALUE=99.8
      SPEC STREAM=A5, COMP=5, RATE, RATIO,REFF,VALUE=0.999 
      $SPEC STREAM=S2, COMP=4, RATE,RATIO,REFF,VALUE=0.99,ATOL=0.001  
      SPEC RRATIO VALUE=1.5
      TFLOW NET(V)=PV5,2,NET(L)=PL5,1
      TFLOW PA(L)=PF5,10,10
      PA FROM=10,TO=10,LFRAC=0.8,PHASE=L
      VARI HEAT=1,2
      TSIZE

  HX UID=E05
       HOT FEED=PV5,L=P5,DP(MMHG)=5
       DEFINE DUTY AS COLUMN=T105 DUTY(1)

   HCURVE UID=H05
       ISO HX=E05 POINT=5 HOT
     
 PUMP UID=P7
       FEED A4
       PRODUCT L=S55
       OPERATION PRES=3.0  
  
  SPLITTER UID=SP5
      FEED S55
      PRODUCT M=ME1,M=ME2
       OPERATION OPTION=FILL
       SPEC STREAM=ME1,RATE(WT,KG/H),DIVIDE,REFFED,VALUE=0.77       
  
   CALCULATOR UID=CA6
       SEQUENCE  STREAM=C2
       PROCEDURE
       V(1)=SCMR(3,C2)
       R(1)=V(1)
       RETURN

  SPLITTER UID=SP2
      FEED B5
      PRODUCT M=S40,M=S41
      OPERTION OPTION=FILL
      SPEC STREAM=S40 RATE(W), DIVIDE,CALCULATOR=CA6,&
      R(1),VALUE=1

   HX  UID=E5
       HOT  FEED=S41, M=S42
       OPER HTEMP=40
  
   FLASH UID=F3
       FEED B3
       PRODUCT L=BB,V=AA
       TPSPEC TEMP=130
       SPEC STRM=BB,RATE(W),VALUE=225
 
   PUMP UID=P5
       FEED BB
       PRODUCT L=S50
       OPERATION EFF=50,DP=3.3
     
   COLUMN UID=T106
      PARAMETER TRAY=20,IO=400
      FEED AA,12
      PRODUCT  OVHD(WT)=A6,450, BTMS(WT)=B6
      CONDENSER TYPE=BUBB,PRES(MMHG)=65
      DUTY 1,1/2,20  
      PSPEC PTOP(MMHG)=85 , DPCOLUMN(MMHG)=35
     $ PRINT COMPOSITION=M,WT, PROPTABLE=PART
      ESTIMATE MODEL=CONV, RRATIO=1, CTEMP=119, BTEMP=140
      &TEMPERATURE 1,80/2,150/19,160                  
      SPEC STREAM=B6, COMP=6, RATE, RATIO,REFF,VALUE=0.975 
      SPEC RRATIO VALUE=4
      TFLOW NET(V)=PV6,2,NET(L)=PL6,1
      TFLOW PA(L)=PF6,20,20
      PA FROM=20,TO=20,LFRAC=0.8,PHASE=L
      VARI HEAT=1,2
      TSIZE

   HX UID=E06
       HOT FEED=PV6,L=P6,DP(MMHG)=20
       DEFINE DUTY AS COLUMN=T106 DUTY(1)
  
   HCURVE UID=H06
       ISO HX=E06 POINT=5 HOT
      
   COLUMN UID=T107
      PARAMETER TRAY=30,IO=100
      FEED B6,15
      PRODUCT  OVHD(WT)=A7,970, BTMS(WT)=B7
      CONDENSER TYPE=BUBB,PRES(MMHG)=65
      DUTY 1,1/2,30 
      PSPEC PTOP(MMHG)=90 , DPCOLUMN(MMHG)=40
     $ PRINT COMPOSITION=M,WT, PROPTABLE=PART
      ESTIMATE MODEL=CONV, RRATIO=1, CTEMP=120, BTEMP=170
      &TEMPERATURE 1,80/2,150/19,160                  
      SPEC STREAM=A7, COMP=6, RATE(w), RATIO,REFF,VALUE=0.999,ATOL=0.0001
    $ SPEC STREAM=D2, COMP=7, RATE,RATIO,REFF,VALUE=0.99,ATOL=0.001  
      SPEC RRATIO VALUE=4.5
      TFLOW NET(V)=PV7,2,NET(L)=PL7,1
      TFLOW PA(L)=PF7,30,30
      PA FROM=30,TO=30,LFRAC=0.8,PHASE=L
      VARI HEAT=1,2
      TSIZE

   HX UID=E07
       HOT FEED=PV7,L=P7,DP(MMHG)=25
       DEFINE DUTY AS COLUMN=T107 DUTY(1)

   HCURVE UID=H07
       ISO HX=E07 POINT=5 HOT
       
   HX UID=E6
       HOT  FEED=A7, M=AA7
       OPER HTEMP=40

   HX UID=E7
       HOT  FEED=B7, M=BB7
       OPER HTEMP=40
   
   PUMP UID=P6
       FEED A6
       PRODUCT L=S39
       OPERATION PRES(MMHG)=1520
     
   COLUMN UID=T108
      PARAMETER TRAY=10,SURE=400
      FEED S39,4
      PRODUCT  OVHD(WT)=A8,90, BTMS(WT)=B8
      CONDENSER TYPE=BUBB,PRES=1.013,test=65
      DUTY 1,1/2,10 
      PSPEC PTOP=1.313, DPCOLUMN=0.5
 $     PRINT COMPOSITION=M,WT, PROPTABLE=PART
      ESTIMATE MODEL=SIMPLE, RRATIO=1, CTEMP=65, BTEMP=160
      &TEMPERATURE 1,80/2,150/19,160                  
      SPEC STREAM=A8, COMP=4, RATE(w), RATIO,REFF,VALUE=0.96 
      SPEC RRATIO VALUE=2
      TFLOW NET(V)=PV8,2,NET(L)=PL8,1
      TFLOW PA(L)=PF8,10,10
      PA FROM=10,TO=10,LFRAC=0.8,PHASE=L
      VARI HEAT=1,2
      TSIZE

   HX UID=E08
       HOT FEED=PV8,L=P8,DP=0.2
       DEFINE DUTY AS COLUMN=T108 DUTY(1)

   HCURVE UID=H08
       ISO HX=E08 POINT=5 HOT
      
   PUMP UID=P8
       FEED A8
       PRODUCT L=ME3
       OPERATION PRES=3.0  

recycle data
acce type=wegs,start=2
loop no=1,start=ca3,end=p1,trial=50
loop no=2,start=m3,end=p5,trial=50
loop no=3,start=ca2,end=p8,trial=50
  END  

